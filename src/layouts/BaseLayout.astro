---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Ticker from '../components/Ticker.astro';

export interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = 'The official directory of British Army esports — disciplines, Corps, events and results.',
  active,
} = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} — British Army Esports</title>
  </head>
  <body>
    <Nav active={active} />
    <Ticker />
    <main>
      <slot />
    </main>
  </body>
</html>
