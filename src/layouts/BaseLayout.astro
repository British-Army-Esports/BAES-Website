---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Ticker from '../components/Ticker.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = 'The official directory of British Army esports: disciplines, Corps, events and results.',
  active,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} — British Army Esports</title>
  </head>
  <body>
    <Nav active={active} />
    <Ticker />
    {
      !isHome && (
        <div class="container back-nav">
          <button type="button" class="back-nav__button" id="back-button">
            ← Back
          </button>
        </div>
      )
    }
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      const backButton = document.getElementById('back-button');
      if (backButton) {
        backButton.addEventListener('click', () => {
          // Only go back if there's actual history to return to (e.g. not
          // a page opened directly in a new tab), otherwise fall back home.
          if (window.history.length > 1) {
            window.history.back();
          } else {
            window.location.href = '/';
          }
        });
      }
    </script>
  </body>
</html>

<style>
  .back-nav {
    padding-top: 1.25rem;
  }

  .back-nav__button {
    background: transparent;
    border: none;
    color: var(--text-secondary-alt);
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s var(--ease-out);
  }

  .back-nav__button:hover {
    color: var(--crimson-bright);
  }
</style>
