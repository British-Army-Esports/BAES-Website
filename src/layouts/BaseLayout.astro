---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Ticker from '../components/Ticker.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  active?: string;
}

const {
  title,
  description = 'The official directory of British Army esports: disciplines, Corps, events and results.',
  active,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
const pageTitle = `${title} — British Army Esports`;
const ogImageUrl = new URL('/social/og-image.png', Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>

    <!--
      Open Graph / Twitter Card: without these, a link shared to Discord,
      Slack, X, etc. renders with no preview image at all — it's not
      related to the site's own HTTPS status, just meta tags that were
      never added. One shared og:image for every page for now (the crest
      lockup) rather than a per-page one; revisit if a specific page (an
      event, a news story) later wants its own.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="British Army Esports" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <!--
      Preload the two weights used above the fold on every page (Rajdhani
      700 for headings/nav, Inter 400 for body copy) so the browser starts
      fetching the real font files immediately rather than only discovering
      them after it's fetched and parsed the stylesheet. Shortens the
      fallback-font flash; doesn't eliminate it on a cold cache, nothing
      short of `font-display: block` fully does that, and that trades the
      flash for a worse invisible-text delay instead.
    -->
    <link rel="preload" href="/fonts/rajdhani-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Nav active={active} />
    <Ticker />
    {
      !isHome && (
        <div class="container back-nav">
          <button type="button" class="back-nav__button" id="back-button">
            ← Back
          </button>
        </div>
      )
    }
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      const backButton = document.getElementById('back-button');
      if (backButton) {
        backButton.addEventListener('click', () => {
          // Only go back if there's actual history to return to (e.g. not
          // a page opened directly in a new tab), otherwise fall back home.
          if (window.history.length > 1) {
            window.history.back();
          } else {
            window.location.href = '/';
          }
        });
      }
    </script>
  </body>
</html>

<style>
  .back-nav {
    padding-top: 1.25rem;
  }

  .back-nav__button {
    background: transparent;
    border: none;
    color: var(--text-secondary-alt);
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s var(--ease-out);
  }

  .back-nav__button:hover {
    color: var(--crimson-bright);
  }
</style>
