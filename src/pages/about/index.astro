---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About" active="About" description="About British Army Esports.">
  <section class="section container">
    <p class="section__eyebrow label">About</p>
    <h1 class="section__heading">About British Army Esports</h1>

    <div class="prose">
      <p>
        This site is the official directory for British Army esports — a hub across disciplines
        and Corps, not a replacement for what individual Corps publish themselves. It brings
        together disciplines, Corps, events, results, and locations in one place.
      </p>
      <p>
        Esports sits under <a href="https://britisharmysport.com/" target="_blank" rel="noopener noreferrer">Army Sport</a>
        governance — see their <a href="https://britisharmysport.com/army-e-sports/" target="_blank" rel="noopener noreferrer">esports page</a> too.
      </p>
      <p>
        British Army Esports is also part of a wider UK Armed Forces and defence esports
        ecosystem — see the links in the footer, including the
        <a href="http://ideg.gg/" target="_blank" rel="noopener noreferrer">International Defence Esports Games</a>
        and <a href="https://bfbsesports.com/" target="_blank" rel="noopener noreferrer">BFBS Esports</a>.
      </p>
      <p>
        Got a question, correction, or something to report? Use the
        <a href="/feedback">Feedback</a> page.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
    max-width: 640px;
  }

  .section__eyebrow {
    color: var(--crimson-bright);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    margin-bottom: 1.5rem;
  }

  .prose {
    color: var(--text-secondary-alt);
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .prose a {
    color: var(--crimson-bright);
    font-weight: 600;
  }
</style>
