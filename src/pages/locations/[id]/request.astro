---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const locations = await getCollection('locations', ({ data }) => data.active);
  return locations.map((location) => ({
    params: { id: location.id },
    props: { location },
  }));
}

const { location } = Astro.props;
const formName = `hub-request-${location.id}`;
---

<BaseLayout
  title={`Request Access — ${location.data.name}`}
  description={`Request access or ask a question about ${location.data.name}.`}
>
  <section class="section container">
    <p class="section__eyebrow label">Request Access</p>
    <h1 class="section__heading">{location.data.name}</h1>
    <p class="section__address">{location.data.address}</p>
    {location.data.status && <p class="section__status">{location.data.status}</p>}
    {
      location.data.equipment && location.data.equipment.length > 0 && (
        <ul class="equipment-list">
          {location.data.equipment.map((item: string) => (
            <li>{item}</li>
          ))}
        </ul>
      )
    }

    {
      ((location.data.photos && location.data.photos.length > 0) ||
        (location.data.enhancedPhotos && location.data.enhancedPhotos.length > 0)) && (
        <div class="photo-section">
          <div class="photo-header">
            <p class="photo-banner" data-photo-banner hidden>
              🪄 AI-stylised vision — what we think this space <em>could</em> look like, not how it
              looks today.
            </p>
            {
              location.data.enhancedPhotos && location.data.enhancedPhotos.length > 0 && (
                <button type="button" class="photo-toggle" data-photo-toggle>
                  ✨ Enhance!
                </button>
              )
            }
          </div>

          {
            location.data.photos && location.data.photos.length > 0 && (
              <div class="photo-grid" data-photo-grid="real">
                {location.data.photos.map((src: string) => (
                  <img class="photo-grid__img clip-tl-sm" src={src} alt="" loading="lazy" />
                ))}
              </div>
            )
          }

          {
            location.data.enhancedPhotos && location.data.enhancedPhotos.length > 0 && (
              <div class="photo-grid" data-photo-grid="enhanced" hidden>
                {location.data.enhancedPhotos.map((src: string) => (
                  <img class="photo-grid__img clip-tl-sm" src={src} alt="" loading="lazy" />
                ))}
              </div>
            )
          }
        </div>
      )
    }

    <p class="section__intro">
      Fill in the form below to request access, ask a question, or arrange a visit. Your message
      goes directly to this hub's point of contact — their email address is never published or
      exposed on this site.
    </p>

    <form
      name={formName}
      method="POST"
      action="/feedback/thanks"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="request-form"
    >
      <input type="hidden" name="form-name" value={formName} />
      <input type="hidden" name="hub" value={location.data.name} />
      <p class="form-honeypot">
        <label>
          Don't fill this out if you're human: <input name="bot-field" />
        </label>
      </p>

      <div class="form-field">
        <label for="name">Your Name</label>
        <input type="text" id="name" name="name" required autocomplete="name" />
      </div>

      <div class="form-field">
        <label for="email">Your Email</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>

      <div class="form-field">
        <label for="unit">Unit / Corps (optional)</label>
        <input type="text" id="unit" name="unit" />
      </div>

      <div class="form-field">
        <label for="message">What are you requesting?</label>
        <textarea id="message" name="message" required></textarea>
      </div>

      <button type="submit" class="form-submit clip-tl-sm">
        Send Request
        <span>→</span>
      </button>
    </form>
  </section>
</BaseLayout>

<script>
  const toggle = document.querySelector('[data-photo-toggle]');
  const banner = document.querySelector('[data-photo-banner]');
  const realGrid = document.querySelector('[data-photo-grid="real"]');
  const enhancedGrid = document.querySelector('[data-photo-grid="enhanced"]');

  toggle?.addEventListener('click', () => {
    // Currently showing enhanced if its grid is visible (not hidden) —
    // toggle flips both grids and the banner together, and relabels the
    // button so it always describes what clicking it will do next.
    const showingEnhanced = enhancedGrid && !enhancedGrid.hidden;
    if (enhancedGrid) enhancedGrid.hidden = showingEnhanced;
    if (realGrid) realGrid.hidden = !showingEnhanced;
    if (banner) banner.hidden = showingEnhanced;
    toggle.textContent = showingEnhanced ? '✨ Enhance!' : '← Show Real Photos';
  });
</script>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
    max-width: 640px;
  }

  .section__eyebrow {
    color: var(--crimson-bright);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 0.4rem;
  }

  .section__address {
    color: var(--text-secondary-alt);
    margin: 0 0 0.5rem;
  }

  .section__status {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0 0 1rem;
  }

  .equipment-list {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .equipment-list li {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-secondary-alt);
    font-size: 0.8rem;
    padding: 0.35rem 0.75rem;
  }

  .photo-section {
    margin: 0 0 1.5rem;
  }

  .photo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .photo-banner {
    margin: 0;
    color: var(--crimson-bright);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .photo-banner[hidden] {
    display: none;
  }

  .photo-banner em {
    font-style: italic;
  }

  .photo-toggle {
    flex-shrink: 0;
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary-alt);
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .photo-toggle:hover {
    color: var(--crimson-bright);
    border-color: var(--crimson);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.6rem;
  }

  .photo-grid[hidden] {
    display: none;
  }

  .photo-grid__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .section__intro {
    color: var(--text-secondary-alt);
    margin: 0 0 2rem;
    line-height: 1.6;
  }

  .request-form {
    margin-top: 1rem;
  }
</style>
