---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MapView from '../../components/MapView.astro';

const venueKey = [
  { label: 'Arena', body: 'Competition venue plus a good audience viewing setup.' },
  { label: 'Comp Venue', body: '2x5 PCs and a streaming setup.' },
  { label: 'Training Venue', body: '1x 5 PCs.' },
  { label: 'Limited Setup', body: 'Not enough PCs for a full team, e.g. 4 rigs or console-only.' },
  { label: 'Gaming Room', body: "Equipment on hand hasn't been confirmed yet." },
];
---

<BaseLayout title="Locations" active="Locations" description="Permanent British Army Esports gaming hubs.">
  <section class="section container">
    <p class="section__eyebrow label">Locations</p>
    <h1 class="section__heading">Our Locations</h1>
    <p class="section__intro">
      Permanent gaming hubs across garrisons. For fixtures and events, see the{' '}
      <a href="/events">Events</a> page.
    </p>

    <details class="key">
      <summary class="key__summary label">What do the venue types mean?</summary>
      <dl class="key__list">
        {
          venueKey.map((v) => (
            <div class="key__row">
              <dt>{v.label}</dt>
              <dd>{v.body}</dd>
            </div>
          ))
        }
      </dl>
    </details>
  </section>
  <section class="container">
    <MapView showEvents={false} />
  </section>
</BaseLayout>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: 1.5rem;
  }

  .section__eyebrow {
    color: var(--crimson-bright);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .section__intro {
    color: var(--text-secondary-alt);
    max-width: 640px;
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .section__intro a {
    color: var(--crimson-bright);
    font-weight: 600;
  }

  .key {
    max-width: 640px;
    margin-bottom: 1.5rem;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .key__summary {
    padding: 0.75rem 1rem;
    cursor: pointer;
    color: var(--text-secondary-alt);
  }

  .key__summary:hover {
    color: var(--crimson-bright);
  }

  .key__list {
    margin: 0;
    padding: 0 1rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .key__row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .key__row dt {
    font-weight: 700;
    color: var(--text-primary);
  }

  .key__row dd {
    margin: 0;
    color: var(--text-secondary);
  }

  @media (max-width: 480px) {
    .key__row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }

  .container {
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }
</style>
