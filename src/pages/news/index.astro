---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';

const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="News" active="News" description="News from British Army Esports.">
  <section class="section container">
    <p class="section__eyebrow label">News</p>
    <h1 class="section__heading">News</h1>
    <p class="section__intro">
      Match results, roster news, and programme updates. Follow along on{' '}
      <a href="https://x.com/BritArmyesports" target="_blank" rel="noopener noreferrer">X</a>{' '}
      or <a href="https://www.twitch.tv/britisharmyesports" target="_blank" rel="noopener noreferrer">Twitch</a>{' '}
      too.
    </p>

    <div class="grid">
      {
        posts.map((post) => (
          <Card
            category={post.data.date.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'short',
              year: 'numeric',
            })}
            title={post.data.title}
            meta={post.data.summary}
            href={`/news/${post.id}`}
          />
        ))
      }
      {posts.length === 0 && <p class="empty">No news posted yet.</p>}
    </div>

    <h2 class="section__subheading">Got a Story?</h2>
    <p class="section__body">
      Seen coverage of British Army Esports, or have your own news to share? Send the link and a
      couple of lines and we'll turn it into a post.
    </p>

    <form
      name="news-tip"
      method="POST"
      action="/feedback/thanks"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="tip-form"
    >
      <input type="hidden" name="form-name" value="news-tip" />
      <p class="form-honeypot">
        <label>
          Don't fill this out if you're human: <input name="bot-field" />
        </label>
      </p>

      <div class="form-field">
        <label for="name">Your Name</label>
        <input type="text" id="name" name="name" required autocomplete="name" />
      </div>

      <div class="form-field">
        <label for="email">Your Email (optional)</label>
        <input type="email" id="email" name="email" autocomplete="email" />
      </div>

      <div class="form-field">
        <label for="url">Story URL</label>
        <input type="url" id="url" name="url" required placeholder="https://" />
      </div>

      <div class="form-field">
        <label for="summary">Quick Summary</label>
        <textarea id="summary" name="summary" required></textarea>
      </div>

      <button type="submit" class="form-submit clip-tl-sm">
        Send Tip
        <span>→</span>
      </button>
    </form>
  </section>
</BaseLayout>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .section__eyebrow {
    color: var(--crimson-bright);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .section__intro {
    color: var(--text-secondary-alt);
    max-width: 640px;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .section__intro a {
    color: var(--crimson-bright);
    font-weight: 600;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .empty {
    color: var(--text-secondary);
  }

  .section__subheading {
    font-size: 1.3rem;
    margin: 3.5rem 0 0.75rem;
  }

  .section__body {
    color: var(--text-secondary-alt);
    line-height: 1.6;
    max-width: 560px;
    margin: 0 0 1.5rem;
  }

  .tip-form {
    max-width: 560px;
  }
</style>
