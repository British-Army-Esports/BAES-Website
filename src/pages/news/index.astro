---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="News" active="News" description="News from British Army Esports.">
  <section class="section container">
    <p class="section__eyebrow label">News</p>
    <h1 class="section__heading">Coming Soon</h1>
    <p class="section__intro">
      Match results, roster news, and programme updates will appear here. In the meantime, follow
      along on <a href="https://x.com/BritArmyesports" target="_blank" rel="noopener noreferrer">X</a>
      or <a href="https://www.twitch.tv/britisharmyesports" target="_blank" rel="noopener noreferrer">Twitch</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .section {
    padding-top: clamp(3rem, 8vw, 5rem);
    padding-bottom: clamp(4rem, 10vw, 6rem);
    text-align: center;
  }

  .section__eyebrow {
    color: var(--crimson-bright);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    margin-bottom: 1rem;
  }

  .section__intro {
    color: var(--text-secondary-alt);
    max-width: 480px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .section__intro a {
    color: var(--crimson-bright);
    font-weight: 600;
  }
</style>
