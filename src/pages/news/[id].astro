---
import { getCollection, getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { formatEventDate } from '../../lib/eventDate';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const isStandard = post.data.layout === 'standard';

// Photos stored beside a CMS article are resized and converted at build, so
// a full-size phone photo uploaded through the CMS is never what visitors
// download (and its metadata, e.g. GPS location, is stripped in the process).
// Site-path photos (/photos/...) are already web-sized and used as-is.
type Photo = string | ImageMetadata;
const sized = async (p: Photo, width: number, format: 'webp' | 'jpeg' = 'webp') =>
  typeof p === 'string' ? p : (await getImage({ src: p, width: Math.min(width, p.width), format })).src;

const lead = post.data.image;
const leadSrc = lead ? await sized(lead, 1400) : undefined;
// Social previews: JPEG, since not every platform renders WebP previews.
const shareImage = lead ? await sized(lead, 1200, 'jpeg') : undefined;
const gallery = post.data.gallery
  ? await Promise.all(
      post.data.gallery.map(async (g) => ({
        src: await sized(g.src, 800),
        full: await sized(g.src, 1920),
        caption: g.caption,
      })),
    )
  : [];

const related = post.data.relatedEvent ? await getEntry(post.data.relatedEvent) : undefined;
---

<BaseLayout title={post.data.title} active="News" description={post.data.summary} image={shareImage}>
  <article class="section container">
    <p class="section__eyebrow label">
      {post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
    </p>
    <h1 class="section__heading">{post.data.title}</h1>
    {
      isStandard && leadSrc && (
        <figure class="lead">
          <img class="lead__img" src={leadSrc} alt={post.data.imageCaption ?? ''} />
          {post.data.imageCaption && <figcaption class="lead__caption">{post.data.imageCaption}</figcaption>}
        </figure>
      )
    }
    <div class="prose">
      <Content />
    </div>
    {
      isStandard && gallery.length > 0 && (
        <section class="reel" aria-label="Photos">
          <h2 class="reel__heading label">Photos</h2>
          <PhotoGallery photos={gallery} />
        </section>
      )
    }
    {
      related && (
        <a class="related clip-tl-sm" href={`/events/${related.id}`}>
          <span class="related__label label">Related fixture</span>
          <span class="related__title">{related.data.title} →</span>
          <span class="related__meta">
            {formatEventDate(related.data).text}
            {related.data.resultsSummary && ` · ${related.data.resultsSummary}`}
          </span>
        </a>
      )
    }
    {
      post.data.sources && post.data.sources.length > 0 && (
        <div class="sources">
          <p class="sources__label label">Further Coverage</p>
          <ul class="sources__list">
            {post.data.sources.map((source: { label: string; url: string }) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.label} ↗
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
    <a href="/news" class="back-link">← All news</a>
  </article>
</BaseLayout>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
    max-width: 680px;
  }

  .section__eyebrow {
    color: var(--crimson-text);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    margin-bottom: 1.5rem;
  }

  .prose {
    color: var(--text-secondary-alt);
    line-height: 1.75;
  }

  .prose :global(p) {
    margin: 0 0 1.25rem;
  }

  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    margin: 0 0 1.25rem;
  }

  .prose :global(h2) {
    font-size: 1.3rem;
    color: var(--text-primary);
    margin: 2.25rem 0 0.9rem;
  }

  .prose :global(a) {
    color: var(--crimson-text);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose :global(figure) {
    margin: 0 0 1.5rem;
  }

  .prose :global(figure img) {
    margin: 0;
  }

  .prose :global(figcaption) {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Tall/portrait images (phone screenshots, portrait photos) capped so a
     single one doesn't fill several screens. */
  .prose :global(figure.portrait img) {
    width: auto;
    max-width: 100%;
    max-height: 560px;
    margin: 0 auto;
  }

  .lead {
    margin: 0 0 1.75rem;
  }

  .lead__img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
  }

  .lead__caption {
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .reel {
    margin-top: 2rem;
  }

  .reel__heading {
    color: var(--text-secondary);
    margin: 0 0 0.75rem;
  }

  .related {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border-left: 2px solid var(--crimson);
    transition: background 0.2s var(--ease-out);
  }

  .related:hover {
    background: var(--surface-alt);
  }

  .related__label {
    color: var(--crimson-text);
  }

  .related__title {
    color: var(--text-primary);
    font-weight: 700;
  }

  .related__meta {
    color: var(--text-secondary-alt);
    font-size: 0.85rem;
  }

  .sources {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .sources__label {
    color: var(--text-secondary);
    margin: 0 0 0.75rem;
  }

  .sources__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sources__list a {
    color: var(--crimson-text);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .back-link {
    display: inline-block;
    margin-top: 2rem;
    color: var(--crimson-text);
    font-weight: 600;
    font-size: 0.85rem;
  }
</style>
