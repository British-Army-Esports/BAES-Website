---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { formatEventDate } from '../../lib/eventDate';

const allDisciplines = await getCollection('disciplines', ({ data }) => data.active);
const disciplineInfo = new Map(
  allDisciplines.map((d) => [d.id, { name: d.data.name, color: d.data.color }]),
);

const now = Date.now();

const events = (await getCollection('events'))
  .map((event) => {
    const disciplineIds = (event.data.disciplines ?? []).map((d) => d.id);
    const disciplineNames = disciplineIds.map((id) => disciplineInfo.get(id)?.name).filter(Boolean);
    const accentColor = disciplineIds.map((id) => disciplineInfo.get(id)?.color).find(Boolean);

    const start = event.data.date.getTime();
    const end = (event.data.endDate ?? event.data.date).getTime();
    // A TBC date is, by definition, not a known point in time, so it can
    // never honestly be classified as "past" — it always sits in Upcoming
    // until someone confirms a real date.
    const isPast = event.data.dateStatus !== 'tbc' && end < now;
    // "In progress" mirrors the Ticker/MapView live rule: only a confirmed,
    // genuinely competitive/mixed presence counts, never TBC/provisional.
    const isLive =
      event.data.presenceType !== 'community-outreach' &&
      (event.data.dateStatus ?? 'confirmed') === 'confirmed' &&
      now >= start &&
      now <= end;

    return {
      id: event.id,
      title: event.data.title,
      scale: event.data.scale,
      disciplineIds,
      disciplineNames,
      accentColor,
      locationName: event.data.location?.name ?? 'Online / TBC',
      externalLink: event.data.externalLink,
      resultsSummary: event.data.resultsSummary,
      sortDate: start,
      isPast,
      isLive,
      ...formatEventDate(event.data),
    };
  })
  .sort((a, b) => a.sortDate - b.sortDate);

const inProgress = events.filter((e) => e.isLive);
const upcoming = events.filter((e) => !e.isPast && !e.isLive);
const past = events.filter((e) => e.isPast).reverse();

// Only offer filter pills for disciplines that actually have at least one event.
const usedDisciplineIds = new Set(events.flatMap((e) => e.disciplineIds));
const filterDisciplines = allDisciplines.filter((d) => usedDisciplineIds.has(d.id));

const scaleLabels: Record<string, string> = {
  'unit-garrison': 'Unit / Garrison',
  corps: 'Corps',
  'inter-corps': 'Inter-Corps',
  army: 'Army (National)',
  'inter-service-international': 'Inter-Service / International',
  'mixed-community': 'Mixed / Community',
};
---

<BaseLayout title="Events" active="Events" description="Upcoming and past British Army Esports fixtures.">
  <section class="section container">
    <p class="section__eyebrow label">Compete</p>
    <h1 class="section__heading">Events &amp; Competitions</h1>
    <p class="section__intro">
      The fixtures programme: Corps-level matches through to national and international
      competitions. Dates marked "Likely" or "TBC" aren't confirmed yet.
    </p>

    {
      filterDisciplines.length > 0 && (
        <div class="filters" role="group" aria-label="Filter by game">
          <button type="button" class="filters__pill is-active" data-filter="all">
            All Games
          </button>
          {filterDisciplines.map((d) => (
            <button type="button" class="filters__pill" data-filter={d.id}>
              {d.data.name}
            </button>
          ))}
        </div>
      )
    }

    {
      inProgress.length > 0 && (
        <>
          <h2 class="section__subheading section__subheading--live">
            <span class="live-dot" /> In Progress
          </h2>
          <div class="event-grid">
            {inProgress.map((event) => (
              <EventCard event={event} scaleLabels={scaleLabels} live />
            ))}
          </div>
        </>
      )
    }

    <h2 class="section__subheading">Upcoming</h2>
    <div class="event-grid">
      {upcoming.map((event) => <EventCard event={event} scaleLabels={scaleLabels} />)}
      {upcoming.length === 0 && <p class="empty">No upcoming fixtures published yet.</p>}
    </div>

    <h2 class="section__subheading">Past &amp; History</h2>
    <div class="event-grid">
      {past.map((event) => <EventCard event={event} scaleLabels={scaleLabels} />)}
      {past.length === 0 && <p class="empty">No past fixtures logged yet.</p>}
    </div>
  </section>
</BaseLayout>

<script>
  const pills = document.querySelectorAll('.filters__pill');
  const items = document.querySelectorAll('[data-disciplines]');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.classList.remove('is-active'));
      pill.classList.add('is-active');
      const filter = pill.getAttribute('data-filter');

      items.forEach((item) => {
        if (filter === 'all') {
          item.hidden = false;
          return;
        }
        const ids = (item.getAttribute('data-disciplines') || '').split(',');
        item.hidden = !ids.includes(filter);
      });
    });
  });
</script>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .section__eyebrow {
    color: var(--crimson-bright);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .section__intro {
    color: var(--text-secondary-alt);
    max-width: 640px;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .section__subheading {
    font-size: 1.25rem;
    margin: 2.5rem 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .section__subheading--live {
    color: var(--crimson-bright);
  }

  .live-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--crimson-bright);
    animation: pulse-dot-events 1.6s var(--ease-out) infinite;
  }

  @keyframes pulse-dot-events {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .filters__pill {
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .filters__pill.is-active {
    color: var(--crimson-bright);
    border-color: var(--crimson);
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.1rem;
  }

  .empty {
    padding: 2rem 1.25rem;
    color: var(--text-secondary);
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    grid-column: 1 / -1;
  }
</style>
