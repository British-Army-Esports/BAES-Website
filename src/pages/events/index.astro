---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatEventDate } from '../../lib/eventDate';

const allDisciplines = await getCollection('disciplines', ({ data }) => data.active);
const disciplineNames = new Map(allDisciplines.map((d) => [d.id, d.data.name]));

const events = (await getCollection('events'))
  .map((event) => {
    const disciplineIds = (event.data.disciplines ?? []).map((d) => d.id);
    const now = Date.now();
    const end = (event.data.endDate ?? event.data.date).getTime();
    // A TBC date is, by definition, not a known point in time, so it can
    // never honestly be classified as "past" — it always sits in Upcoming
    // until someone confirms a real date.
    const isPast = event.data.dateStatus !== 'tbc' && end < now;
    return {
      id: event.id,
      title: event.data.title,
      scale: event.data.scale,
      disciplineIds,
      disciplineNames: disciplineIds.map((id) => disciplineNames.get(id)).filter(Boolean),
      locationName: event.data.location?.name ?? 'Online / TBC',
      externalLink: event.data.externalLink,
      sortDate: event.data.date.getTime(),
      isPast,
      ...formatEventDate(event.data),
    };
  })
  .sort((a, b) => a.sortDate - b.sortDate);

const upcoming = events.filter((e) => !e.isPast);
const past = events.filter((e) => e.isPast).reverse();

// Only offer filter pills for disciplines that actually have at least one event.
const usedDisciplineIds = new Set(events.flatMap((e) => e.disciplineIds));
const filterDisciplines = allDisciplines.filter((d) => usedDisciplineIds.has(d.id));

const scaleLabels: Record<string, string> = {
  'unit-garrison': 'Unit / Garrison',
  corps: 'Corps',
  'inter-corps': 'Inter-Corps',
  army: 'Army (National)',
  'inter-service-international': 'Inter-Service / International',
  'mixed-community': 'Mixed / Community',
};
---

<BaseLayout title="Events" active="Events" description="Upcoming and past British Army Esports fixtures.">
  <section class="section container">
    <p class="section__eyebrow label">Compete</p>
    <h1 class="section__heading">Events &amp; Competitions</h1>
    <p class="section__intro">
      The fixtures programme: Corps-level matches through to national and international
      competitions. Dates marked "Likely" or "TBC" aren't confirmed yet.
    </p>

    {
      filterDisciplines.length > 0 && (
        <div class="filters" role="group" aria-label="Filter by game">
          <button type="button" class="filters__pill is-active" data-filter="all">
            All Games
          </button>
          {filterDisciplines.map((d) => (
            <button type="button" class="filters__pill" data-filter={d.id}>
              {d.data.name}
            </button>
          ))}
        </div>
      )
    }

    <h2 class="section__subheading">Upcoming</h2>
    <ul class="event-list">
      {
        upcoming.map((event) => (
          <li class="event-list__item" data-disciplines={event.disciplineIds.join(',')}>
            <span class:list={['event-list__date', `event-list__date--${event.badge}`]}>
              {event.text}
            </span>
            <div class="event-list__body">
              {
                event.externalLink ? (
                  <a href={event.externalLink} target="_blank" rel="noopener noreferrer" class="event-list__title event-list__title--link">
                    {event.title} ↗
                  </a>
                ) : (
                  <span class="event-list__title">{event.title}</span>
                )
              }
              <span class="event-list__scale label">
                {scaleLabels[event.scale]}
                {event.disciplineNames.length > 0 && ` · ${event.disciplineNames.join(', ')}`}
              </span>
            </div>
            <span class="event-list__meta">{event.locationName}</span>
          </li>
        ))
      }
      {upcoming.length === 0 && <li class="empty">No upcoming fixtures published yet.</li>}
    </ul>

    <h2 class="section__subheading">Past &amp; History</h2>
    <ul class="event-list">
      {
        past.map((event) => (
          <li class="event-list__item" data-disciplines={event.disciplineIds.join(',')}>
            <span class="event-list__date">{event.text}</span>
            <div class="event-list__body">
              {
                event.externalLink ? (
                  <a href={event.externalLink} target="_blank" rel="noopener noreferrer" class="event-list__title event-list__title--link">
                    {event.title} ↗
                  </a>
                ) : (
                  <span class="event-list__title">{event.title}</span>
                )
              }
              <span class="event-list__scale label">
                {scaleLabels[event.scale]}
                {event.disciplineNames.length > 0 && ` · ${event.disciplineNames.join(', ')}`}
              </span>
            </div>
            <span class="event-list__meta">{event.locationName}</span>
          </li>
        ))
      }
      {past.length === 0 && <li class="empty">No past fixtures logged yet.</li>}
    </ul>
  </section>
</BaseLayout>

<script>
  const pills = document.querySelectorAll('.filters__pill');
  const items = document.querySelectorAll('.event-list__item');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      pills.forEach((p) => p.classList.remove('is-active'));
      pill.classList.add('is-active');
      const filter = pill.getAttribute('data-filter');

      items.forEach((item) => {
        if (filter === 'all') {
          item.hidden = false;
          return;
        }
        const ids = (item.getAttribute('data-disciplines') || '').split(',');
        item.hidden = !ids.includes(filter);
      });
    });
  });
</script>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .section__eyebrow {
    color: var(--crimson-bright);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .section__intro {
    color: var(--text-secondary-alt);
    max-width: 640px;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .section__subheading {
    font-size: 1.25rem;
    margin: 2.5rem 0 1rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .filters__pill {
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .filters__pill.is-active {
    color: var(--crimson-bright);
    border-color: var(--crimson);
  }

  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .event-list__item {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .event-list__item:last-child {
    border-bottom: none;
  }

  .event-list__date {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .event-list__date--provisional,
  .event-list__date--tbc {
    color: var(--text-secondary);
    font-style: italic;
  }

  .event-list__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .event-list__title {
    font-weight: 600;
    color: var(--text-primary);
  }

  .event-list__title--link {
    color: var(--text-primary);
    text-decoration: none;
  }

  .event-list__title--link:hover {
    color: var(--crimson-bright);
  }

  .event-list__scale {
    color: var(--text-secondary);
  }

  .event-list__meta {
    color: var(--text-secondary);
    font-size: 0.85rem;
    text-align: right;
  }

  .empty {
    padding: 2rem 1.25rem;
    color: var(--text-secondary);
    text-align: center;
  }

  @media (max-width: 640px) {
    .event-list__item {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
    .event-list__meta {
      text-align: left;
    }
  }
</style>
