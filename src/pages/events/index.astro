---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { formatEventDate } from '../../lib/eventDate';

const allDisciplines = await getCollection('disciplines', ({ data }) => data.active);
const disciplineInfo = new Map(
  allDisciplines.map((d) => [d.id, { name: d.data.name, color: d.data.color }]),
);

const now = Date.now();

const events = (await getCollection('events'))
  .map((event) => {
    const disciplineIds = (event.data.disciplines ?? []).map((d) => d.id);
    const disciplineNames = disciplineIds.map((id) => disciplineInfo.get(id)?.name).filter(Boolean);
    const accentColor = disciplineIds.map((id) => disciplineInfo.get(id)?.color).find(Boolean);

    const start = event.data.date.getTime();
    const end = (event.data.endDate ?? event.data.date).getTime();
    // A TBC date is, by definition, not a known point in time, so it can
    // never honestly be classified as "past" — it always sits in Upcoming
    // until someone confirms a real date.
    const isPast = event.data.dateStatus !== 'tbc' && end < now;
    // "In progress" mirrors the Ticker/MapView live rule: only a confirmed,
    // genuinely competitive/mixed presence counts, never TBC/provisional.
    const isLive =
      event.data.presenceType !== 'community-outreach' &&
      (event.data.dateStatus ?? 'confirmed') === 'confirmed' &&
      now >= start &&
      now <= end;

    return {
      id: event.id,
      title: event.data.title,
      scale: event.data.scale,
      team: event.data.team,
      presenceType: event.data.presenceType,
      tier: event.data.tier,
      disciplineIds,
      disciplineNames,
      accentColor,
      // "TBC" is a claim about an unresolved future — never honest for
      // something that's already happened, so a past event with no
      // recorded venue just says so plainly instead.
      locationName: event.data.location?.name ?? (isPast ? 'Not recorded' : 'Online / TBC'),
      externalLink: event.data.externalLink,
      resultsSummary: event.data.resultsSummary,
      sortDate: start,
      isPast,
      isLive,
      ...formatEventDate(event.data),
    };
  })
  .sort((a, b) => a.sortDate - b.sortDate);

const inProgress = events.filter((e) => e.isLive);
const upcoming = events.filter((e) => !e.isPast && !e.isLive);
// Major: British Army Lions/UKAF-level fixtures and large public LAN
// engagement presences (EPIC, Enclave). Minor: Army-internal competitions
// (BAEL and similar) and smaller engagement presences. This is an
// editorial call, not derived from `scale` — a few "engagement"-scale
// entries (EPIC, Enclave) are major here precisely because of the size of
// the public audience, not the competitive level.
const upcomingMajor = upcoming.filter((e) => e.tier === 'major');
const upcomingMinor = upcoming.filter((e) => e.tier !== 'major');
const past = events.filter((e) => e.isPast).reverse();

// Only offer filter options for disciplines/scales that actually have at
// least one event, so the dropdowns never show a choice with zero results.
const usedDisciplineIds = new Set(events.flatMap((e) => e.disciplineIds));
const filterDisciplines = allDisciplines.filter((d) => usedDisciplineIds.has(d.id));

const scaleLabels: Record<string, string> = {
  engagement: 'Engagement',
  'single-service': 'Army-Wide',
  military: 'Military (Tri-Service)',
  'uk-national': 'UK National',
  'international-military': 'International Military',
  european: 'European',
};

const scaleOrder = Object.keys(scaleLabels);
const usedScales = new Set(events.map((e) => e.scale));
const filterScales = scaleOrder.filter((s) => usedScales.has(s));

const teamLabels: Record<string, string> = {
  corps: 'Corps Team',
  baes: 'BAES Team',
  ukaf: 'UKAF Team',
};

const presenceLabels: Record<string, string> = {
  competitive: 'Competitive',
  'community-outreach': 'Community Outreach',
  mixed: 'Mixed',
};

const presenceOrder = Object.keys(presenceLabels);
const usedPresenceTypes = new Set(events.map((e) => e.presenceType));
const filterPresenceTypes = presenceOrder.filter((p) => usedPresenceTypes.has(p));
---

<BaseLayout title="Events" active="Events" description="Upcoming and past British Army Esports fixtures.">
  <section class="section container">
    <p class="section__eyebrow label">Compete</p>
    <h1 class="section__heading">Events &amp; Competitions</h1>
    <p class="section__intro">
      The fixtures programme: Corps-level matches through to national and international
      competitions. Dates marked "Likely" or "TBC" aren't confirmed yet.
    </p>

    <div class="filters clip-tl-sm">
      {
        filterDisciplines.length > 0 && (
          <div class="filters__field">
            <label class="label" for="filter-discipline">
              Discipline
            </label>
            <select id="filter-discipline" class="filters__select">
              <option value="all">All Games</option>
              {filterDisciplines.map((d) => (
                <option value={d.id}>{d.data.name}</option>
              ))}
            </select>
          </div>
        )
      }

      {
        filterScales.length > 0 && (
          <div class="filters__field">
            <label class="label" for="filter-scale">
              Level
            </label>
            <select id="filter-scale" class="filters__select">
              <option value="all">All Levels</option>
              {filterScales.map((s) => (
                <option value={s}>{scaleLabels[s]}</option>
              ))}
            </select>
          </div>
        )
      }

      {
        filterPresenceTypes.length > 0 && (
          <div class="filters__field">
            <span class="label">Event Type</span>
            <div class="filters__checks" role="group" aria-label="Filter by event type">
              {filterPresenceTypes.map((p) => (
                <label class="filters__check">
                  <input type="checkbox" value={p} class="filter-presence-check" />
                  {presenceLabels[p]}
                </label>
              ))}
            </div>
          </div>
        )
      }
    </div>

    {
      inProgress.length > 0 && (
        <>
          <h2 class="section__subheading section__subheading--live">
            <span class="live-dot" /> In Progress
          </h2>
          <div class="event-grid">
            {inProgress.map((event) => (
              <EventCard event={event} scaleLabels={scaleLabels} teamLabels={teamLabels} live />
            ))}
          </div>
        </>
      )
    }

    <h2 class="section__subheading">Upcoming</h2>

    <p class="row-label label">Major Fixtures — Army Lions, UKAF &amp; large public LAN events</p>
    <div class="event-scroll clip-tl-sm">
      <div class="event-row">
        {upcomingMajor.map((event) => <EventCard event={event} scaleLabels={scaleLabels} teamLabels={teamLabels} />)}
        {upcomingMajor.length === 0 && <p class="empty">No major fixtures confirmed yet.</p>}
      </div>
    </div>

    <p class="row-label label">Army &amp; Local Fixtures — BAEL, internal and smaller engagements</p>
    <div class="event-scroll clip-tl-sm">
      <div class="event-row">
        {upcomingMinor.map((event) => <EventCard event={event} scaleLabels={scaleLabels} teamLabels={teamLabels} />)}
        {upcomingMinor.length === 0 && <p class="empty">No Army/local fixtures confirmed yet.</p>}
      </div>
    </div>

    <h2 class="section__subheading section__subheading--muted">Past &amp; History</h2>
    <ul class="past-list">
      {
        past.map((event) => (
          <li data-disciplines={event.disciplineIds.join(',')} data-scale={event.scale} data-presence={event.presenceType}>
            <a href={event.externalLink ?? `/events/${event.id}`} target={event.externalLink ? '_blank' : undefined} rel={event.externalLink ? 'noopener noreferrer' : undefined}>
              {event.title}
            </a>
            <span class="past-list__meta">
              {event.text}
              {event.locationName && ` · ${event.locationName}`}
              {event.resultsSummary && ` · ${event.resultsSummary}`}
            </span>
          </li>
        ))
      }
      {past.length === 0 && <li class="empty">No past fixtures logged yet.</li>}
    </ul>
  </section>
</BaseLayout>

<script>
  const disciplineSelect = document.getElementById('filter-discipline');
  const scaleSelect = document.getElementById('filter-scale');
  const presenceChecks = document.querySelectorAll('.filter-presence-check');
  const items = document.querySelectorAll('[data-disciplines]');

  function applyFilters() {
    const discipline = disciplineSelect?.value ?? 'all';
    const scale = scaleSelect?.value ?? 'all';
    const checkedPresence = Array.from(presenceChecks)
      .filter((c) => c.checked)
      .map((c) => c.value);

    items.forEach((item) => {
      const ids = (item.getAttribute('data-disciplines') || '').split(',');
      const itemScale = item.getAttribute('data-scale') || '';
      const itemPresence = item.getAttribute('data-presence') || '';

      const disciplineMatch = discipline === 'all' || ids.includes(discipline);
      const scaleMatch = scale === 'all' || itemScale === scale;
      const presenceMatch = checkedPresence.length === 0 || checkedPresence.includes(itemPresence);

      item.hidden = !(disciplineMatch && scaleMatch && presenceMatch);
    });
  }

  disciplineSelect?.addEventListener('change', applyFilters);
  scaleSelect?.addEventListener('change', applyFilters);
  presenceChecks.forEach((c) => c.addEventListener('change', applyFilters));
</script>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .section__eyebrow {
    color: var(--crimson-bright);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    margin-bottom: 0.75rem;
    background: linear-gradient(120deg, var(--text-primary) 55%, var(--crimson-bright) 130%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section__intro {
    color: var(--text-secondary-alt);
    max-width: 640px;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .section__subheading {
    font-size: 1.25rem;
    margin: 2.5rem 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--crimson);
  }

  .section__subheading--live {
    color: var(--crimson-bright);
    border-left-color: var(--crimson-bright);
  }

  .section__subheading--muted {
    color: var(--text-secondary);
    border-left-color: var(--border);
  }

  .live-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--crimson-bright);
    animation: pulse-dot-events 1.6s var(--ease-out) infinite;
  }

  @keyframes pulse-dot-events {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: flex-end;
    margin-bottom: 1.75rem;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid transparent;
    border-image: linear-gradient(100deg, var(--crimson) 0%, var(--border) 35%, var(--border) 100%) 1;
  }

  .filters__field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .filters__select {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--text-primary-dim);
    background: var(--bg-base-alt);
    border: 1px solid var(--border);
    padding: 0.55rem 0.75rem;
    min-width: 180px;
    cursor: pointer;
    transition: border-color 0.2s var(--ease-out);
  }

  .filters__select:focus,
  .filters__select:hover {
    outline: none;
    border-color: var(--crimson);
  }

  .filters__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    min-height: 2.35rem;
    align-items: center;
  }

  .filters__check {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-secondary-alt);
    cursor: pointer;
  }

  .filters__check input {
    accent-color: var(--crimson);
    width: 15px;
    height: 15px;
    cursor: pointer;
  }

  .event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.1rem;
  }

  .row-label {
    color: var(--text-secondary-alt);
    margin: 1.5rem 0 0.6rem;
  }

  .row-label:first-of-type {
    margin-top: 0.5rem;
  }

  .event-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.3rem 0.3rem 0.9rem;
    border: 1px solid transparent;
    border-image: linear-gradient(100deg, var(--crimson) 0%, var(--border) 25%, var(--border) 100%) 1;
    background: linear-gradient(90deg, rgba(200, 16, 46, 0.04) 0%, transparent 8%);
  }

  .event-row {
    display: flex;
    flex-wrap: nowrap;
    gap: 1.1rem;
  }

  .event-row :global(.event-card) {
    flex: 0 0 280px;
  }

  .event-scroll::-webkit-scrollbar {
    height: 8px;
  }

  .event-scroll::-webkit-scrollbar-track {
    background: var(--bg-base-alt);
  }

  .event-scroll::-webkit-scrollbar-thumb {
    background: var(--crimson);
  }

  .empty {
    padding: 2rem 1.25rem;
    color: var(--text-secondary);
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    grid-column: 1 / -1;
  }

  .past-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    background: var(--bg-base-alt);
  }

  .past-list li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1.5rem;
    padding: 0.65rem 1.1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
  }

  .past-list li:last-child {
    border-bottom: none;
  }

  .past-list li[hidden] {
    display: none;
  }

  .past-list a {
    color: var(--text-secondary-alt);
    font-weight: 600;
    transition: color 0.2s var(--ease-out);
  }

  .past-list a:hover {
    color: var(--crimson-bright);
  }

  .past-list__meta {
    color: var(--text-secondary);
    text-align: right;
  }

  .past-list .empty {
    text-align: left;
    background: none;
    border: none;
    padding: 0.65rem 1.1rem;
  }
</style>
