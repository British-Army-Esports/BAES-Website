---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatEventDate } from '../../lib/eventDate';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { id: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;

const disciplineEntries = event.data.disciplines
  ? await Promise.all(event.data.disciplines.map((d) => getEntry(d)))
  : [];
const disciplineNames = disciplineEntries.filter(Boolean).map((d) => d!.data.name);
const accentColor = disciplineEntries.find(Boolean)?.data.color;

const corpsEntry = event.data.corps ? await getEntry(event.data.corps) : undefined;

const { text: dateText, badge } = formatEventDate(event.data);

const scaleLabels: Record<string, string> = {
  engagement: 'Engagement',
  'single-service': 'Army-Wide',
  military: 'Military (Tri-Service)',
  'uk-national': 'UK National',
  'international-military': 'International Military',
  european: 'European',
};

const teamLabels: Record<string, string> = {
  corps: 'Corps Team',
  baes: 'BAES Team',
  ukaf: 'UKAF Team',
};

const presenceLabels: Record<string, string> = {
  competitive: 'Competitive Fixture',
  'community-outreach': 'Community Outreach',
  mixed: 'Mixed Presence',
};

const accent = accentColor || '#c8102e';
---

<BaseLayout
  title={event.data.title}
  active="Events"
  description={event.data.description ?? `${event.data.title} — British Army Esports fixture.`}
>
  <section class="section container" style={`--accent: ${accent}`}>
    <p class="section__eyebrow label">{presenceLabels[event.data.presenceType]}</p>
    <h1 class="section__heading">{event.data.title}</h1>

    <div class="meta-row">
      <span class:list={['meta-pill', `meta-pill--${badge}`]}>{dateText}</span>
      <span class="meta-pill meta-pill--outline">{scaleLabels[event.data.scale]}</span>
      {event.data.team && <span class="meta-pill meta-pill--outline">{teamLabels[event.data.team]}</span>}
      {corpsEntry && <span class="meta-pill meta-pill--outline">{corpsEntry.data.name}</span>}
    </div>

    {
      disciplineNames.length > 0 && (
        <p class="disciplines">{disciplineNames.join(' · ')}</p>
      )
    }

    {event.data.location && <p class="location">📍 {event.data.location.name}</p>}

    {
      event.data.resultsSummary && (
        <div class="result clip-tl-sm">
          <span class="result__label label">Result</span>
          <span class="result__text">{event.data.resultsSummary}</span>
        </div>
      )
    }

    {event.data.description && <p class="description">{event.data.description}</p>}

    {
      event.data.externalLink ? (
        <a class="cta clip-tl-sm" href={event.data.externalLink} target="_blank" rel="noopener noreferrer">
          Visit Official Event Page ↗
        </a>
      ) : (
        <div class="placeholder clip-tl-sm">
          <p>More info coming soon.</p>
          <p class="placeholder__sub">
            We don't have a public page for this fixture yet. Check back nearer the date, or ask on{' '}
            <a href="https://discord.gg/D5SrQ6xAdw" target="_blank" rel="noopener noreferrer">
              Discord
            </a>
            .
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
    max-width: 720px;
  }

  .section__eyebrow {
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    margin-bottom: 1rem;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }

  .meta-pill {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    color: var(--text-primary);
  }

  .meta-pill--outline {
    color: var(--text-secondary-alt);
  }

  .meta-pill--provisional,
  .meta-pill--tbc {
    color: var(--text-secondary);
    font-style: italic;
  }

  .meta-pill--confirmed {
    border-color: var(--accent);
    color: var(--accent);
  }

  .disciplines {
    color: var(--text-secondary-alt);
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .location {
    color: var(--text-secondary);
    margin: 0 0 1.25rem;
  }

  .result {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: rgba(200, 16, 46, 0.08);
    border-left: 2px solid var(--crimson);
    padding: 0.65rem 1rem;
    margin-bottom: 1.25rem;
  }

  .result__label {
    color: var(--crimson-bright);
  }

  .result__text {
    color: var(--text-primary-dim);
  }

  .description {
    color: var(--text-secondary-alt);
    line-height: 1.7;
    margin: 0 0 1.75rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--crimson);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
    padding: 0.85rem 1.5rem;
    transition: background 0.2s var(--ease-out);
  }

  .cta:hover {
    background: var(--crimson-bright);
  }

  .placeholder {
    background: var(--surface);
    border: 1px dashed var(--border);
    padding: 1.25rem 1.5rem;
  }

  .placeholder p {
    margin: 0;
  }

  .placeholder__sub {
    margin-top: 0.5rem !important;
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .placeholder a {
    color: var(--crimson-bright);
    font-weight: 600;
  }
</style>
