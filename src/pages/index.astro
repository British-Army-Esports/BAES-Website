---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Card from '../components/Card.astro';
import Table from '../components/Table.astro';
import MapView from '../components/MapView.astro';
import EventCard from '../components/EventCard.astro';
import { getImage } from 'astro:assets';
import { formatEventDate, compareEventDates, getLiveStatus, eventEndMs, seasonInfo, locationLabel } from '../lib/eventDate';

const disciplines = await getCollection('disciplines');

// Latest News: a teaser for the newest article, not the article itself.
// CMS-uploaded lead photos are resized here the same way the article page
// does it; site-path photos (/photos/...) are already web-sized.
const latestPost = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
)[0];
const latestImage = latestPost?.data.image;
const latestImageSrc =
  latestImage === undefined
    ? undefined
    : typeof latestImage === 'string'
      ? latestImage
      : (await getImage({ src: latestImage, width: Math.min(900, latestImage.width), format: 'webp' })).src;

const allDisciplines = await getCollection('disciplines', ({ data }) => data.active);
const disciplineInfo = new Map(
  allDisciplines.map((d) => [d.id, { name: d.data.name, color: d.data.color }]),
);

const now = Date.now();

// Key Events: the next few fixtures worth front-page billing — genuinely
// competitive/mixed presences at a national level or above, not every
// festival stand or outreach appearance.
const keyScales = new Set(['uk-national', 'international-military', 'military', 'european']);
const keyEvents = (await getCollection('events'))
  .filter((e) => e.data.presenceType !== 'community-outreach' && keyScales.has(e.data.scale))
  .map((event) => {
    const disciplineIds = (event.data.disciplines ?? []).map((d) => d.id);
    const disciplineNames = disciplineIds.map((id) => disciplineInfo.get(id)?.name).filter(Boolean);
    const accentColor = disciplineIds.map((id) => disciplineInfo.get(id)?.color).find(Boolean);
    const start = event.data.date.getTime();
    const end = eventEndMs(event.data);
    const isPast = event.data.dateStatus !== 'tbc' && end < now;
    const { isLive } = getLiveStatus(event.data, now);
    return {
      id: event.id,
      title: event.data.title,
      scale: event.data.scale,
      team: event.data.team,
      presenceType: event.data.presenceType,
      disciplineIds,
      disciplineNames,
      accentColor,
      locationName: locationLabel(event.data, isPast),
      externalLink: event.data.externalLink,
      resultsSummary: event.data.resultsSummary,
      sortDate: start,
      isPast,
      isLive,
      season: seasonInfo(event.data),
      ...formatEventDate(event.data),
    };
  })
  .filter((e) => !e.isPast)
  .sort(compareEventDates)
  .slice(0, 3);

const keyEventScaleLabels: Record<string, string> = {
  engagement: 'Engagement',
  'single-service': 'Army-Wide',
  military: 'Military (Tri-Service)',
  'uk-national': 'UK National',
  'international-military': 'International Military',
  european: 'European',
};

const keyEventTeamLabels: Record<string, string> = {
  corps: 'Corps Team',
  baes: 'BAES Team',
  ukaf: 'UKAF Team',
};

// Overall Corps ranking for the 2026 Esports Cup: points summed across
// every discipline's standings. Real data, not a placeholder — naturally
// empty until results exist.
const allStandings = await getCollection('standings');
const allCorpsForNames = await getCollection('corps');
const corpsNames = new Map(allCorpsForNames.map((c) => [c.id, c.data.name]));
const overallPoints = new Map<string, number>();
for (const s of allStandings) {
  for (const row of s.data.rows) {
    overallPoints.set(row.corps.id, (overallPoints.get(row.corps.id) ?? 0) + row.pts);
  }
}
const overallRows = [...overallPoints.entries()]
  .map(([corpsId, pts]) => ({
    name: corpsNames.get(corpsId) ?? corpsId,
    played: 0,
    won: 0,
    lost: 0,
    gd: 0,
    pts,
  }))
  .sort((a, b) => b.pts - a.pts);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsOrganization',
  name: 'British Army Esports',
  url: 'https://britisharmyesports.org.uk/',
  logo: 'https://britisharmyesports.org.uk/logos/brand/army-esports-lockup.png',
  sport: 'Esports',
  parentOrganization: { '@type': 'SportsOrganization', name: 'Army Sport', url: 'https://britisharmysport.com/' },
  sameAs: [
    'https://x.com/BritArmyesports',
    'https://www.instagram.com/britisharmyesports/',
    'https://www.facebook.com/people/British-Army-Esports/61594544326434/',
    'https://www.twitch.tv/britisharmyesports',
    'https://www.youtube.com/c/BritishArmyEsports',
  ],
};
---

<BaseLayout title="Home" active="Home" jsonLd={orgJsonLd}>
  <Hero />

  {
    latestPost && (
      <section class="section container">
        <h2 class="section__heading">Latest News</h2>
        <p class="section__note label">
          <a href="/news">All news →</a>
        </p>
        <a class:list={['latest', { 'latest--no-image': !latestImageSrc }]} href={`/news/${latestPost.id}`}>
          {latestImageSrc && (
            <img class="latest__img" src={latestImageSrc} alt="" loading="lazy" decoding="async" />
          )}
          <div class="latest__body">
            <p class="latest__date label">
              {latestPost.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </p>
            <h3 class="latest__title">{latestPost.data.title}</h3>
            <p class="latest__summary">{latestPost.data.summary}</p>
            <span class="latest__more">Read the full story <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </section>
    )
  }

  <section class="section container">
    <h2 class="section__heading">Disciplines</h2>
    <div class="grid">
      {
        disciplines.map((d) => (
          <Card
            category={d.data.ticker ?? 'Discipline'}
            title={d.data.name}
            meta={d.data.tagline}
            href={`/disciplines/${d.id}`}
            image={d.data.icon}
          />
        ))
      }
    </div>
  </section>

  <section class="section container">
    <h2 class="section__heading">Key Events</h2>
    <p class="section__note label">
      National-level fixtures and above, coming up. <a href="/events">Full fixtures list →</a>
    </p>
    {
      keyEvents.length > 0 ? (
        <div class="grid">
          {keyEvents.map((event) => (
            <EventCard
              event={event}
              scaleLabels={keyEventScaleLabels}
              teamLabels={keyEventTeamLabels}
              live={event.isLive}
            />
          ))}
        </div>
      ) : (
        <p class="empty">No national-level fixtures confirmed yet. Check the full fixtures list.</p>
      )
    }
  </section>

  <section class="section container">
    <h2 class="section__heading">2026 Esports Cup</h2>
    <p class="section__note label">
      Overall Corps ranking, points summed across every discipline. <a href="/2026-esports-cup">Full breakdown →</a>
    </p>
    {
      overallRows.length > 0 ? (
        <Table rows={overallRows} />
      ) : (
        <p class="empty">The 2026 Cup hasn't started yet. Check back once results come in.</p>
      )
    }
  </section>

  <section class="section container">
    <h2 class="section__heading">Locations &amp; Events</h2>
    <MapView />
  </section>
</BaseLayout>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .section__heading {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    margin-bottom: 0.5rem;
  }

  .section__note {
    margin-bottom: 1.5rem;
  }

  .section__note a {
    color: var(--crimson-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .empty {
    color: var(--text-secondary);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .latest {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--crimson);
    color: inherit;
    transition: border-color 0.2s var(--ease-out);
  }

  .latest:hover {
    border-color: var(--crimson-bright);
  }

  .latest--no-image {
    grid-template-columns: 1fr;
  }

  .latest__img {
    width: 100%;
    height: 100%;
    min-height: 220px;
    max-height: 360px;
    object-fit: cover;
    display: block;
  }

  .latest__body {
    padding: clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
  }

  .latest__date {
    color: var(--crimson-text);
  }

  .latest__title {
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.15;
  }

  .latest__summary {
    color: var(--text-secondary-alt);
    line-height: 1.6;
    margin: 0;
  }

  .latest__more {
    color: var(--crimson-text);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    margin-top: 0.25rem;
  }

  .latest:hover .latest__more {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 760px) {
    .latest {
      grid-template-columns: 1fr;
    }

    .latest__img {
      height: auto;
      aspect-ratio: 16 / 9;
      min-height: 0;
    }
  }
</style>
