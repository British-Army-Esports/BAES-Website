---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Table from '../../components/Table.astro';
import { formatEventDate } from '../../lib/eventDate';

export async function getStaticPaths() {
  const disciplines = await getCollection('disciplines');
  return disciplines.map((discipline) => ({
    params: { id: discipline.id },
    props: { discipline },
  }));
}

const { discipline } = Astro.props;
const { Content } = await render(discipline);

const now = Date.now();

const relatedEvents = (await getCollection('events'))
  .filter((e) => e.data.disciplines?.some((d) => d.id === discipline.id))
  .map((event) => {
    const start = event.data.date.getTime();
    const end = (event.data.endDate ?? event.data.date).getTime();
    // Mirrors the Events page rules: a TBC date can never honestly be
    // "past", and "live" only counts a confirmed, non-outreach fixture.
    const isPast = event.data.dateStatus !== 'tbc' && end < now;
    const isLive =
      event.data.presenceType !== 'community-outreach' &&
      (event.data.dateStatus ?? 'confirmed') === 'confirmed' &&
      now >= start &&
      now <= end;
    return {
      title: event.data.title,
      locationName: event.data.location?.name ?? 'Online / TBC',
      sortDate: start,
      isPast,
      isLive,
      ...formatEventDate(event.data),
    };
  })
  .sort((a, b) => a.sortDate - b.sortDate);

const liveFixtures = relatedEvents.filter((e) => e.isLive);
const upcomingFixtures = relatedEvents.filter((e) => !e.isPast && !e.isLive);
const pastFixtures = relatedEvents.filter((e) => e.isPast).reverse();

// Standings: Corps are the teams in the official tournament. Empty (no
// content file yet, or a file with zero rows) shows an honest "not yet
// published" state rather than fabricated placeholder rows.
const standingsEntry = (await getCollection('standings')).find(
  (s) => s.data.discipline.id === discipline.id,
);
const standingsRows = (standingsEntry?.data.rows ?? [])
  .map((row) => ({
    name: row.corps.id,
    played: row.played,
    won: row.won,
    lost: row.lost,
    gd: row.gd,
    pts: row.pts,
  }))
  .sort((a, b) => b.pts - a.pts);
// Resolve Corps names for display (row.corps is just a reference id at this
// point since content-layer references aren't auto-resolved).
const allCorps = await getCollection('corps');
const corpsNames = new Map(allCorps.map((c) => [c.id, c.data.name]));
const standingsTableRows = standingsRows.map((r) => ({ ...r, name: corpsNames.get(r.name) ?? r.name }));
---

<BaseLayout title={discipline.data.name} active="Disciplines" description={discipline.data.tagline}>
  <section class="section container">
    <p class="section__eyebrow label">Discipline</p>
    <div class="header">
      {discipline.data.icon && <img class="header__icon clip-tl-sm" src={discipline.data.icon} alt="" />}
      <div>
        <h1 class="section__heading">{discipline.data.name}</h1>
        {discipline.data.tagline && <p class="section__tagline">{discipline.data.tagline}</p>}
      </div>
    </div>

    <div class="prose">
      <Content />
    </div>

    <h2 class="section__subheading">Standings</h2>
    <p class="section__note label">2026 Esports Cup: Corps standings</p>
    {
      standingsTableRows.length > 0 ? (
        <Table rows={standingsTableRows} />
      ) : (
        <p class="empty">Standings not yet published for 2026.</p>
      )
    }

    {
      liveFixtures.length > 0 && (
        <>
          <h2 class="section__subheading section__subheading--live">
            <span class="live-dot" /> In Progress
          </h2>
          <ul class="event-list">
            {liveFixtures.map((event) => (
              <li class="event-list__item">
                <span class="event-list__date">{event.text}</span>
                <span class="event-list__title">{event.title}</span>
                <span class="event-list__meta">{event.locationName}</span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <h2 class="section__subheading">Upcoming Fixtures</h2>
    {
      upcomingFixtures.length > 0 ? (
        <ul class="event-list">
          {upcomingFixtures.map((event) => (
            <li class="event-list__item">
              <span class="event-list__date">{event.text}</span>
              <span class="event-list__title">{event.title}</span>
              <span class="event-list__meta">{event.locationName}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No upcoming fixtures published yet for this discipline.</p>
      )
    }

    <h2 class="section__subheading section__subheading--muted">Past Fixtures</h2>
    {
      pastFixtures.length > 0 ? (
        <ul class="event-list event-list--past">
          {pastFixtures.map((event) => (
            <li class="event-list__item">
              <span class="event-list__date">{event.text}</span>
              <span class="event-list__title">{event.title}</span>
              <span class="event-list__meta">{event.locationName}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">No past fixtures logged yet for this discipline.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
    max-width: 720px;
  }

  .section__eyebrow {
    color: var(--crimson-bright);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    margin-bottom: 0.5rem;
  }

  .section__tagline {
    color: var(--text-secondary-alt);
    margin: 0 0 1.5rem;
  }

  .header {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .header__icon {
    width: 88px;
    height: 88px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }

  .prose {
    color: var(--text-secondary-alt);
    line-height: 1.7;
  }

  .section__subheading {
    font-size: 1.3rem;
    margin: 2.5rem 0 1rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .section__subheading--live {
    color: var(--crimson-bright);
  }

  .section__subheading--muted {
    color: var(--text-secondary);
    font-size: 1.05rem;
  }

  .live-dot {
    display: inline-block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--crimson-bright);
    animation: pulse-dot-discipline 1.6s var(--ease-out) infinite;
  }

  @keyframes pulse-dot-discipline {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .section__note {
    color: var(--text-secondary);
    margin: -0.5rem 0 1rem;
  }

  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .event-list--past {
    background: var(--bg-base-alt);
  }

  .event-list--past .event-list__date {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .event-list--past .event-list__title {
    color: var(--text-secondary-alt);
    font-weight: 500;
  }

  .event-list__item {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .event-list__item:last-child {
    border-bottom: none;
  }

  .event-list__date {
    color: var(--crimson-bright);
    font-weight: 600;
  }

  .event-list__title {
    color: var(--text-primary);
    font-weight: 600;
  }

  .event-list__meta {
    color: var(--text-secondary);
    text-align: right;
  }

  .empty {
    color: var(--text-secondary);
  }

  @media (max-width: 560px) {
    .event-list__item {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
    .event-list__meta {
      text-align: left;
    }
  }
</style>
