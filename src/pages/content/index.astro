---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

// Tags of events whose streams are in the production calendar; the Upcoming
// Streams list shows only calendar entries matching one of these.
const streamTags = [...new Set((await getCollection('events')).map((e) => e.data.streamTag).filter(Boolean))];

const baesChannels = [
  { handle: 'britisharmyesports', label: 'British Army Esports' },
  { handle: 'defenceuk', label: 'Defence UK' },
  { handle: 'rafesports', label: 'RAF Esports' },
  { handle: 'royalnavyesports', label: 'Royal Navy Esports' },
  { handle: 'bfbsesports', label: 'BFBS Esports' },
  { handle: 'ukveteransgaming', label: 'UK Veterans Gaming' },
];

const corpsChannels = [
  { handle: 'royalarmouredcorps', label: 'Royal Armoured Corps' },
  { handle: 'remeesports', label: 'REME Esports' },
  { handle: 'rlcesportsofficial', label: 'RLC Esports' },
  { handle: 'sappersgg', label: 'Royal Engineers' },
  { handle: 'rsignals', label: 'Royal Signals' },
  { handle: 'esportsagc', label: 'AGC Esports' },
  { handle: 'britishinfantryesports', label: 'British Infantry Esports' },
  { handle: 'ams_esports', label: 'RAMS Esports' },
];
---

<BaseLayout
  title="Content"
  active="Content"
  description="British Army Esports and Corps Twitch channels, and personal streams from players."
>
  <section class="section container">
    <p class="section__eyebrow label">Content</p>
    <h1 class="section__heading">Content</h1>
    <p class="section__intro">
      Watch live on the channels below — the same as watching a match from the sidelines, just
      online. Match VODs and highlights are on{' '}
      <a href="https://www.youtube.com/c/BritishArmyEsports" target="_blank" rel="noopener noreferrer">
        YouTube
      </a>.
    </p>

    <section class="streams" data-upcoming-streams={JSON.stringify(streamTags)} hidden>
      <h2 class="section__subheading">Upcoming Streams</h2>
      <ul class="streams__list" data-upcoming-list></ul>
    </section>

    <h2 class="section__subheading">Watch the Army Team Compete</h2>
    <div class="channel-grid">
      {
        baesChannels.map((c) => (
          <div class="channel-card">
            <div class="channel-card__player" data-channel={c.handle}>
              <a
                href={`https://www.twitch.tv/${c.handle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="channel-card__link"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="channel-card__icon">
                  <path d="M4.2 2 2 7.4v13.3h5.1V24h3l3-3.3h4.4L23 15.4V2H4.2Zm16.7 12.4-3.4 3.4h-4.6l-3 3.3v-3.3H5.7V4.1h15.2v10.3Z" />
                  <path d="M17.4 7.1h1.9v5.7h-1.9zM12 7.1h1.9v5.7H12z" />
                </svg>
                <span>{c.label}</span>
              </a>
              <button type="button" class="channel-card__watch" data-watch-btn aria-expanded="false">
                Watch ▶
              </button>
            </div>
            <div class="channel-card__frame" data-frame hidden />
          </div>
        ))
      }
    </div>

    <h2 class="section__subheading">Grassroots Competitions</h2>
    <div class="channel-grid">
      {
        corpsChannels.map((c) => (
          <div class="channel-card">
            <div class="channel-card__player" data-channel={c.handle}>
              <a
                href={`https://www.twitch.tv/${c.handle}`}
                target="_blank"
                rel="noopener noreferrer"
                class="channel-card__link"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="channel-card__icon">
                  <path d="M4.2 2 2 7.4v13.3h5.1V24h3l3-3.3h4.4L23 15.4V2H4.2Zm16.7 12.4-3.4 3.4h-4.6l-3 3.3v-3.3H5.7V4.1h15.2v10.3Z" />
                  <path d="M17.4 7.1h1.9v5.7h-1.9zM12 7.1h1.9v5.7H12z" />
                </svg>
                <span>{c.label}</span>
              </a>
              <button type="button" class="channel-card__watch" data-watch-btn aria-expanded="false">
                Watch ▶
              </button>
            </div>
            <div class="channel-card__frame" data-frame hidden />
          </div>
        ))
      }
    </div>

    <p class="disclaimer">
      Some of our players also have their own personal streams. Views and content on individual
      channels are the individual's own and don't represent the British Army or this
      organisation.
    </p>
  </section>
</BaseLayout>

<script>
  import { getStreams, matchesTag, ukDayLabel, ukTime } from '../../lib/streams';

  // Upcoming Streams: next few tagged entries from the production calendar,
  // read live in the browser. Hidden entirely if there's nothing coming up
  // or the calendar can't be reached.
  const upcoming = document.querySelector<HTMLElement>('[data-upcoming-streams]');
  if (upcoming) {
    const tags: string[] = JSON.parse(upcoming.dataset.upcomingStreams!);
    const list = upcoming.querySelector<HTMLElement>('[data-upcoming-list]')!;
    getStreams().then((streams) => {
      const now = Date.now();
      const next = (streams ?? [])
        .filter((e) => e.end > now && tags.some((t) => matchesTag(e.title, t)))
        .slice(0, 6);
      if (next.length === 0) return;
      list.replaceChildren(
        ...next.map((e) => {
          const li = document.createElement('li');
          li.className = 'streams__item';
          const live = e.start <= now;
          const when = document.createElement('span');
          when.className = live ? 'streams__when streams__when--live' : 'streams__when';
          const day = ukDayLabel(e.start, now);
          when.textContent = live ? '● Live now' : `${day[0].toUpperCase()}${day.slice(1)} ${ukTime(e.start)}`;
          const name = document.createElement('span');
          name.className = 'streams__title';
          name.textContent = e.title;
          const a = document.createElement('a');
          a.className = 'streams__watch';
          a.href = e.link ?? 'https://www.twitch.tv/britisharmyesports';
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.textContent = live ? 'Watch →' : 'Channel →';
          li.append(when, name, a);
          return li;
        }),
      );
      upcoming.hidden = false;
    });
  }

  // Twitch's embed player already shows live video or an offline banner on
  // its own; loading 12 of them at once on page load would be heavy, so
  // each channel stays a compact link until someone clicks Watch. The player
  // then opens below the channel name and the button becomes Close, so it
  // can always be shut again (an offline channel's player can be blank on
  // mobile, which used to leave an empty box with no way to dismiss it).
  document.querySelectorAll<HTMLButtonElement>('[data-watch-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.channel-card')!;
      const channel = card.querySelector<HTMLElement>('[data-channel]')!.dataset.channel;
      const frame = card.querySelector<HTMLElement>('[data-frame]')!;
      const opening = btn.getAttribute('aria-expanded') !== 'true';
      if (opening) {
        const iframe = document.createElement('iframe');
        iframe.src = `https://player.twitch.tv/?channel=${channel}&parent=${window.location.hostname}&muted=true`;
        iframe.className = 'channel-card__iframe';
        iframe.title = `${channel} on Twitch`;
        iframe.allowFullscreen = true;
        frame.replaceChildren(iframe);
      } else {
        frame.replaceChildren();
      }
      frame.hidden = !opening;
      btn.setAttribute('aria-expanded', String(opening));
      btn.textContent = opening ? 'Close ✕' : 'Watch ▶';
    });
  });
</script>

<style>
  .section {
    padding-top: clamp(2.5rem, 6vw, 4rem);
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .section__eyebrow {
    color: var(--crimson-text);
    margin-bottom: 0.75rem;
  }

  .section__heading {
    font-size: clamp(1.75rem, 4vw, 3rem);
    margin-bottom: 0.75rem;
  }

  .section__intro {
    color: var(--text-secondary-alt);
    max-width: 640px;
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .section__intro a {
    color: var(--crimson-text);
    font-weight: 600;
  }

  .section__subheading {
    font-size: 1.3rem;
    margin: 2.5rem 0 1.25rem;
  }

  .streams[hidden] {
    display: none;
  }

  .streams__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .streams__list :global(.streams__item) {
    display: grid;
    grid-template-columns: 11rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .streams__list :global(.streams__item:last-child) {
    border-bottom: none;
  }

  .streams__list :global(.streams__when) {
    color: var(--text-secondary-alt);
    font-weight: 600;
  }

  .streams__list :global(.streams__when--live) {
    color: var(--crimson-text);
  }

  .streams__list :global(.streams__title) {
    color: var(--text-primary);
    font-weight: 600;
  }

  .streams__list :global(.streams__watch) {
    color: var(--crimson-text);
    font-weight: 600;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .streams__list :global(.streams__item) {
      grid-template-columns: 1fr auto;
    }

    .streams__list :global(.streams__when) {
      grid-column: 1 / -1;
    }
  }

  .channel-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .channel-card {
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .channel-card__player {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
  }

  .channel-card__frame {
    aspect-ratio: 16 / 9;
    border-top: 1px solid var(--border);
    background: #000;
  }

  .channel-card__frame[hidden] {
    display: none;
  }

  .channel-card__link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-primary-dim);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .channel-card__link:hover {
    color: var(--crimson-text);
  }

  .channel-card__icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--text-secondary);
  }

  .channel-card__watch {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    padding: 0.4rem 0.7rem;
    cursor: pointer;
    flex-shrink: 0;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .channel-card__watch:hover {
    color: var(--crimson-text);
    border-color: var(--crimson);
  }

  .channel-card__iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }

  .disclaimer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.6;
    max-width: 640px;
  }
</style>
