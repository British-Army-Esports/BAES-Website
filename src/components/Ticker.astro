---
import { getCollection } from 'astro:content';
import { eventEndMs, getLiveStatus, seasonInfo, seasonBadge } from '../lib/eventDate';

const now = Date.now();
const events = await getCollection('events');

// Whether the banner shows is decided in the visitor's browser, not here:
// a static build only knows the moment it was built, so a banner decided at
// build time stays up after the event ends (or never appears for one that
// starts later) until the next deploy. The build just hands over every
// fixture that hasn't finished yet; the script below picks whichever is
// live right now, re-checking every minute.
//
// Short, confirmed, non-outreach fixtures count as "live" for their whole
// run (getLiveStatus's rule). A multi-week season would be noise up there for
// months, so a season only shows during its scheduled match nights (its
// streamTime/streamDays). Seasons with a streamTag are left to the stream
// calendar check further down instead.
const liveCandidates = events
  .filter((e) => (e.data.dateStatus ?? 'confirmed') === 'confirmed' && eventEndMs(e.data) > now)
  .map((e) => {
    const external = e.data.streamUrl ?? e.data.externalLink;
    return {
      title: e.data.location ? `${e.data.title} — ${e.data.location.name}` : e.data.title,
      link: external ?? `/events/${e.id}`,
      external: Boolean(external),
      date: e.data.date.toISOString(),
      endDate: e.data.endDate?.toISOString(),
      dateStatus: e.data.dateStatus,
      presenceType: e.data.presenceType,
      season: seasonInfo(e.data),
    };
  });

// Shown in the built HTML too, so the common case doesn't flash in late.
const isOnNow = (c: (typeof liveCandidates)[number], at: number) =>
  getLiveStatus(c, at).isLive || (!!c.season && !c.season.streamTag && !!seasonBadge(c.season, at)?.live);
const liveAtBuild = liveCandidates.find((c) => isOnNow(c, now));

// Tags of events whose streams come from the production calendar. With no
// fixture live, the browser checks the calendar and shows this bar while a
// tagged stream is actually on.
const streamTags = [...new Set(events.map((e) => e.data.streamTag).filter(Boolean))];
---

{
  (liveCandidates.length > 0 || streamTags.length > 0) && (
    <div
      class="ticker"
      data-ticker
      data-events={JSON.stringify(liveCandidates)}
      data-stream-tags={JSON.stringify(streamTags)}
      hidden={!liveAtBuild}
    >
      <div class="ticker__inner container">
        <span class="ticker__pill">
          <span class="pulse-dot" />
          Live Now
        </span>
        <span class="ticker__info" data-ticker-title>
          {liveAtBuild?.title}
        </span>
        <a
          href={liveAtBuild?.link ?? 'https://www.twitch.tv/britisharmyesports'}
          class="ticker__watch"
          target={liveAtBuild && !liveAtBuild.external ? undefined : '_blank'}
          rel={liveAtBuild && !liveAtBuild.external ? undefined : 'noopener noreferrer'}
          data-ticker-link
        >
          Watch Live →
        </a>
      </div>
    </div>
  )
}

<script>
  import { getStreams, matchesTag, type StreamEntry } from '../lib/streams';
  import { getLiveStatus, seasonBadge, type SeasonInfo } from '../lib/eventDate';

  type Candidate = {
    title: string;
    link: string;
    external: boolean;
    date: string;
    endDate?: string;
    dateStatus?: 'confirmed' | 'provisional' | 'tbc';
    presenceType: string;
    season?: SeasonInfo;
  };

  const bar = document.querySelector<HTMLElement>('[data-ticker]');
  if (bar) {
    const candidates: Candidate[] = JSON.parse(bar.dataset.events!);
    const tags: string[] = JSON.parse(bar.dataset.streamTags!);
    const title = bar.querySelector<HTMLElement>('[data-ticker-title]')!;
    const link = bar.querySelector<HTMLAnchorElement>('[data-ticker-link]')!;
    let streams: StreamEntry[] | null = null;

    const show = (text: string, href: string, external: boolean) => {
      title.textContent = text;
      link.href = href;
      if (external) {
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
      } else {
        link.removeAttribute('target');
        link.removeAttribute('rel');
      }
      bar.hidden = false;
    };

    const refresh = () => {
      const now = Date.now();
      const event = candidates.find(
        (c) => getLiveStatus(c, now).isLive || (!!c.season && !c.season.streamTag && !!seasonBadge(c.season, now)?.live),
      );
      if (event) return show(event.title, event.link, event.external);
      const stream = streams?.find((e) => e.start <= now && now < e.end && tags.some((t) => matchesTag(e.title, t)));
      if (stream) return show(stream.title, stream.link ?? 'https://www.twitch.tv/britisharmyesports', true);
      bar.hidden = true;
    };

    refresh();
    if (tags.length > 0) {
      getStreams().then((s) => {
        streams = s;
        refresh();
      });
    }
    setInterval(refresh, 60_000);
  }
</script>

<style>
  .ticker[hidden] {
    display: none;
  }

  .ticker {
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }

  .ticker__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 38px;
    font-family: var(--font-body);
  }

  .ticker__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--crimson);
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    padding: 0.3rem 0.7rem;
    flex-shrink: 0;
  }

  .ticker__info {
    color: var(--text-secondary-alt);
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ticker__watch {
    margin-left: auto;
    flex-shrink: 0;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    color: var(--crimson-text);
  }

  .ticker__watch:hover {
    text-decoration: underline;
  }
</style>
