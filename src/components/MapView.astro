---
import 'leaflet/dist/leaflet.css';
// Base cluster animation CSS only — the bubble look is styled below, not
// the plugin's default green/yellow/orange theme.
import 'leaflet.markercluster/dist/MarkerCluster.css';
import { getCollection } from 'astro:content';
import { formatEventDate } from '../lib/eventDate';

export interface Props {
  // Locations (permanent sites) always show. Events are optional — the
  // dedicated /locations page turns them off since "Locations" means
  // permanent sites specifically; the homepage keeps both for a quick
  // combined overview.
  showEvents?: boolean;
}

const { showEvents = true } = Astro.props;

const allLocations = await getCollection('locations', ({ data }) => data.active);
// Inactive locations are hubs we know about but haven't confirmed/gone live
// with yet (see the "active: false" note on their content files) — shown as
// grey "planned" markers, distinct from confirmed active hubs.
const plannedLocations = await getCollection('locations', ({ data }) => !data.active);
// Only fixtures with a real, plottable venue can be plotted here — online
// qualifiers, not-yet-located internal fixtures, and fixtures where someone
// recorded a venue name but not its coordinates aren't shown on this map
// (they still show the venue name as text everywhere else on the site).
const allEvents = showEvents
  ? (await getCollection('events')).filter(
      (event) => event.data.location?.lat != null && event.data.location?.long != null,
    )
  : [];

// "limited-setup" (not enough PCs for a full team) and "unspecified" (setup
// not yet confirmed) read as the same thing to a visitor — both just mean
// "don't expect a proper venue here" — so they're grouped under one
// display type, "Gaming Room", rather than shown as two near-identical
// categories. The underlying distinction is still kept in the content
// files in case it's useful later.
function displayType(type: string): string {
  return type === 'limited-setup' || type === 'unspecified' ? 'gaming-room' : type;
}

const locationPoints = allLocations.map((loc) => ({
  id: loc.id,
  name: loc.data.name,
  type: displayType(loc.data.type),
  address: loc.data.address,
  equipment: loc.data.equipment ?? [],
  lat: loc.data.location.lat,
  long: loc.data.location.long,
}));

const plannedPoints = plannedLocations.map((loc) => ({
  id: loc.id,
  name: loc.data.name,
  address: loc.data.address,
  status: loc.data.status,
  lat: loc.data.location.lat,
  long: loc.data.location.long,
}));

const now = Date.now();
const eventPoints = allEvents.map((event) => {
  const start = event.data.date.getTime();
  const end = event.data.endDate?.getTime() ?? start + 24 * 60 * 60 * 1000;
  // "Live now" means genuinely in progress right now — not just upcoming.
  // A provisional/TBC date can't honestly be shown as live (same rule as
  // the Ticker), and community-outreach presences don't have a "live"
  // competitive result to show either.
  const isLive =
    event.data.presenceType !== 'community-outreach' &&
    (event.data.dateStatus ?? 'confirmed') === 'confirmed' &&
    now >= start &&
    now <= end;
  // Past events fade out the further back they happened, so the map reads
  // at a glance as "what's current" rather than an even mix of everything
  // that's ever happened. A TBC date has no real "past" to measure, so it
  // never fades. Floors at 0.2 opacity rather than disappearing entirely —
  // still findable on hover/click, just visually out of the way.
  const isPast = event.data.dateStatus !== 'tbc' && end < now;
  const daysSinceEnd = isPast ? (now - end) / (1000 * 60 * 60 * 24) : 0;
  const opacity = isPast ? Math.max(0.2, 1 - daysSinceEnd / 240) : 1;
  return {
    id: event.id,
    name: event.data.title,
    scale: event.data.scale,
    presenceType: event.data.presenceType,
    dateLabel: formatEventDate(event.data).text,
    locationName: event.data.location!.name,
    lat: event.data.location!.lat,
    long: event.data.location!.long,
    live: isLive,
    opacity,
  };
});

const typeLabels: Record<string, string> = {
  'arena-venue': 'Arena Venue',
  'competition-venue': 'Competition Venue',
  'training-venue': 'Training Venue',
  'gaming-room': 'Gaming Room',
};

// Only offer a filter for venue types that actually have at least one
// location, in the same fixed order as typeLabels rather than whatever
// order they happen to appear in the content files.
const usedTypes = Object.keys(typeLabels).filter((t) => locationPoints.some((loc) => loc.type === t));
---

<section class="mapview">
  <div class="mapview__controls">
    <div class="mapview__group" role="group" aria-label="Map layers">
      <button type="button" class="mapview__pill is-active" data-layer="locations">
        <span class="mapview__glyph mapview__glyph--location" aria-hidden="true"></span>Our Locations
      </button>
      {
        plannedPoints.length > 0 && (
          <button type="button" class="mapview__pill is-active" data-layer="planned">
            <span class="mapview__glyph mapview__glyph--planned" aria-hidden="true"></span>Planned
          </button>
        )
      }
      {
        showEvents && (
          <button type="button" class="mapview__pill is-active" data-layer="events">
            <svg class="mapview__glyph mapview__glyph--event" viewBox="0 0 16 15" aria-hidden="true"><path d="M8 1.5 14.8 13.5H1.2Z" /></svg>Events
          </button>
        )
      }
    </div>
    {
      usedTypes.length > 1 && (
        <div class="mapview__group" role="group" aria-label="Venue type">
          {usedTypes.map((t) => (
            <button type="button" class="mapview__pill is-active" data-type-filter={t}>
              {typeLabels[t]}
            </button>
          ))}
        </div>
      )
    }
    <div class="mapview__group" role="group" aria-label="View mode">
      <button type="button" class="mapview__pill is-active" data-view="map">View as Map</button>
      <button type="button" class="mapview__pill" data-view="list">View as List</button>
    </div>
  </div>

  <div id="baes-map" class="mapview__map"></div>

  <ul class="mapview__list" hidden>
    {
      locationPoints.map((loc) => (
        <li class="mapview__list-item" data-type={loc.type}>
          <span class="mapview__list-tag label">{typeLabels[loc.type] ?? loc.type}</span>
          <span class="mapview__list-name">
            {loc.name}
            {loc.equipment.length > 0 && (
              <span class="mapview__list-equipment">{loc.equipment.join(' · ')}</span>
            )}
          </span>
          <span class="mapview__list-meta">
            {loc.address}
            {' · '}
            <a href={`/locations/${loc.id}/request`} class="mapview__list-request">
              Request Access
            </a>
          </span>
        </li>
      ))
    }
    {
      plannedPoints.map((loc) => (
        <li class="mapview__list-item">
          <span class="mapview__list-tag label mapview__list-tag--planned">Planned</span>
          <span class="mapview__list-name">{loc.name}</span>
          <span class="mapview__list-meta">{loc.address}</span>
        </li>
      ))
    }
    {
      eventPoints.map((event) => (
        <li class="mapview__list-item">
          <span class="mapview__list-tag label mapview__list-tag--event">
            {event.live && <span class="mapview__live-dot" aria-label="Live now" />}
            {event.scale.replace(/-/g, ' ')}
          </span>
          <span class="mapview__list-name">{event.name}</span>
          <span class="mapview__list-meta">
            {event.locationName} · {event.dateLabel}
          </span>
        </li>
      ))
    }
    {
      locationPoints.length === 0 && plannedPoints.length === 0 && eventPoints.length === 0 && (
        <li class="mapview__list-empty">No locations or events published yet.</li>
      )
    }
  </ul>
</section>

<script type="application/json" id="baes-map-data" set:html={JSON.stringify({ locationPoints, plannedPoints, eventPoints, typeLabels }).replace(/</g, '\\u003c')}></script>

<script>
  import L from 'leaflet';

  // leaflet.markercluster is a UMD plugin that attaches itself to a global
  // `L`, so the global has to exist before the plugin is loaded.
  (window as any).L = L;
  await import('leaflet.markercluster');

  const dataEl = document.getElementById('baes-map-data');
  const { locationPoints, plannedPoints, eventPoints, typeLabels } = JSON.parse(dataEl.textContent);

  {
    const map = L.map('baes-map', {
      zoomControl: true,
      attributionControl: true,
      minZoom: 4,
    });

    // Standard OSM tiles rather than a niche third-party dark-tile CDN —
    // tile.openstreetmap.org is about as universally allowlisted as a tile
    // host gets, which matters on locked-down networks. Dark styling is
    // faked with a CSS filter on the tile pane instead (see <style> below).
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      subdomains: 'abc',
      maxZoom: 19,
    }).addTo(map);

    // Strip Leaflet's own "Leaflet" self-attribution link — it points to
    // leafletjs.com, whose homepage carries a Ukraine solidarity banner.
    // Not appropriate to link to from an official Army site regardless of
    // the politics involved. OSM attribution above still satisfies their
    // usage terms.
    map.attributionControl.setPrefix(false);

    // Pin shapes borrow controller-button symbology so type reads by shape,
    // not only colour: ○ permanent hub, △ event, □ planned hub (✕ spare).
    // Only a genuinely *live* event gets the filled, pulsing triangle.
    // Each pin sits centred in a 28px hit area — the visible mark stays
    // small, but it's comfortably tappable (WCAG target size is 24px).
    const TRIANGLE_SVG =
      '<svg viewBox="0 0 16 15" width="16" height="15" aria-hidden="true"><path d="M8 1.5 14.8 13.5H1.2Z" /></svg>';
    const makeIcon = (variant: string, pulsing: boolean, opacity = 1) =>
      L.divIcon({
        className: 'map-pin-hit',
        html: `<span class="map-pin map-pin--${variant}${pulsing ? ' map-pin--pulse' : ''}" style="opacity:${opacity}">${variant === 'event' ? TRIANGLE_SVG : ''}</span>`,
        iconSize: [28, 28],
        iconAnchor: [14, 14],
        popupAnchor: [0, -8],
      });

    // Nearby pins (e.g. the Salisbury Plain / Aldershot hubs at UK zoom)
    // merge into a numbered bubble that splits apart as you zoom in.
    const cluster = L.markerClusterGroup({
      maxClusterRadius: 40,
      showCoverageOnHover: false,
      spiderfyOnMaxZoom: true,
      iconCreateFunction: (c) =>
        L.divIcon({
          className: 'map-cluster-hit',
          html: `<span class="map-cluster">${c.getChildCount()}</span>`,
          iconSize: [36, 36],
          iconAnchor: [18, 18],
        }),
    });

    // Popup content is HTML; names/addresses come from CMS-editable content.
    const esc = (s: string) =>
      String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    // Kept as marker+type pairs so the venue-type filter pills can show/hide
    // single pins rather than only the whole "Our Locations" layer at once.
    const locationMarkers = locationPoints.map((loc) => ({
      type: loc.type,
      marker: L.marker([loc.lat, loc.long], { icon: makeIcon('location', false), title: loc.name }).bindPopup(
        `<strong>${esc(loc.name)}</strong><br>${esc(typeLabels[loc.type] ?? loc.type)}<br>${esc(loc.address)}<br><a href="/locations/${loc.id}/request">Request Access →</a>`,
      ),
    }));
    // Planned hubs: known about, not yet confirmed/active. Grey squares, no
    // request link since no such page exists for them yet.
    const plannedMarkers = plannedPoints.map((loc) =>
      L.marker([loc.lat, loc.long], { icon: makeIcon('planned', false), title: `${loc.name} (planned)` }).bindPopup(
        `<strong>${esc(loc.name)}</strong><br>Planned (unconfirmed)<br>${esc(loc.address)}`,
      ),
    );

    const eventMarkers = eventPoints.map((event) =>
      L.marker([event.lat, event.long], { icon: makeIcon('event', event.live, event.opacity), title: event.name }).bindPopup(
        `<strong>${esc(event.name)}</strong>${event.live ? ' <span class="popup-live">● LIVE NOW</span>' : ''}<br>${esc(event.locationName)}<br>${esc(event.dateLabel)}`,
      ),
    );

    // Every marker lives in the one cluster group (so pins of different
    // types still merge when they overlap). Layer pills and venue-type pills
    // just decide which markers are currently in it.
    const activeLayers = new Set(
      Array.from(document.querySelectorAll<HTMLElement>('[data-layer]')).map((btn) => btn.dataset.layer),
    );
    const typeFilterBtns = document.querySelectorAll<HTMLElement>('[data-type-filter]');
    const activeTypes = new Set(Array.from(typeFilterBtns).map((btn) => btn.dataset.typeFilter));
    const listTypeItems = document.querySelectorAll<HTMLElement>('.mapview__list-item[data-type]');

    function refreshMarkers() {
      const visible = [
        ...(activeLayers.has('locations')
          ? locationMarkers
              .filter(({ type }) => typeFilterBtns.length === 0 || activeTypes.has(type))
              .map(({ marker }) => marker)
          : []),
        ...(activeLayers.has('planned') ? plannedMarkers : []),
        ...(activeLayers.has('events') ? eventMarkers : []),
      ];
      cluster.clearLayers();
      cluster.addLayers(visible);
      listTypeItems.forEach((item) => {
        item.hidden = typeFilterBtns.length > 0 && !activeTypes.has(item.dataset.type);
      });
    }


    // Frame the initial view on permanent locations only, not events. Events
    // can be anywhere in the world (C.O.D.E Bowl VII is in San Diego), and
    // including them here would drag the initial view off the UK to fit an
    // outlier. Locations are always UK-based, so they give a stable, sane
    // home view every time; international event pins are still on the map,
    // just reachable by panning rather than driving the initial framing.
    const homeRegionPoints = [...locationPoints, ...plannedPoints];
    if (homeRegionPoints.length > 0) {
      map.fitBounds(
        homeRegionPoints.map((p) => [p.lat, p.long]),
        { padding: [40, 40], maxZoom: 12 },
      );
    } else if (eventPoints.length > 0) {
      map.fitBounds(
        eventPoints.map((p) => [p.lat, p.long]),
        { padding: [40, 40], maxZoom: 12 },
      );
    } else {
      map.setView([54.5, -3], 6);
    }

    // Added only after the map has a centre/zoom — the cluster layer needs
    // one to work out which pins to draw.
    refreshMarkers();
    cluster.addTo(map);

    document.querySelectorAll<HTMLElement>('[data-layer]').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.classList.toggle('is-active');
        if (btn.classList.contains('is-active')) activeLayers.add(btn.dataset.layer);
        else activeLayers.delete(btn.dataset.layer);
        refreshMarkers();
      });
    });

    typeFilterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.classList.toggle('is-active');
        const type = btn.dataset.typeFilter;
        if (btn.classList.contains('is-active')) activeTypes.add(type);
        else activeTypes.delete(type);
        refreshMarkers();
      });
    });

    const mapEl = document.getElementById('baes-map');
    const listEl = document.querySelector('.mapview__list');
    document.querySelectorAll('[data-view]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-view]').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const showMap = btn.dataset.view === 'map';
        mapEl.hidden = !showMap;
        listEl.hidden = showMap;
        if (showMap) map.invalidateSize();
      });
    });
  }
</script>

<style>
  .mapview {
    border: 1px solid var(--border);
    background: var(--surface);
    /* Leaflet's own internal z-indices (tile pane, markers, popups, zoom
       controls) run from ~400 up to 1000+ — far higher than the site's own
       scale (the sticky Nav sits at 50). Without isolating a new stacking
       context here, those internal values compete in the page's global
       stacking order instead of staying contained to the map, and can
       render above the Nav once you scroll past it. */
    position: relative;
    isolation: isolate;
  }

  .mapview__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .mapview__group {
    display: flex;
    gap: 0.5rem;
  }

  .mapview__pill {
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .mapview__pill.is-active {
    color: var(--crimson-text);
    border-color: var(--crimson);
  }

  /* Pin-shape glyphs on the layer pills double as the map legend. */
  .mapview__pill:has(.mapview__glyph) {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .mapview__glyph {
    display: inline-block;
    flex-shrink: 0;
    width: 10px;
    height: 10px;
  }

  .mapview__glyph--location {
    border-radius: 50%;
    background: var(--crimson-bright);
    border: 1.5px solid #fff;
  }

  .mapview__glyph--planned {
    width: 9px;
    height: 9px;
    background: #6b6b6b;
    border: 1.5px solid #3a3a3a;
  }

  .mapview__glyph--event {
    width: 11px;
    height: 10px;
    overflow: visible;
  }

  .mapview__glyph--event path {
    fill: transparent;
    stroke: #fff;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  /* Pill switched off: glyph dims with the label */
  .mapview__pill:not(.is-active) .mapview__glyph {
    opacity: 0.4;
  }

  .mapview__map {
    height: 480px;
    width: 100%;
    background: #0d0d0d;
  }

  /* Fake a dark basemap from standard (light) OSM tiles via CSS filter,
     rather than depending on a separately-hosted dark-tile CDN. Scoped to
     the tile pane only so markers/popups/controls keep their real colours. */
  :global(.mapview__map .leaflet-tile-pane) {
    filter: invert(1) hue-rotate(180deg) brightness(0.95) contrast(0.9) saturate(0.6);
  }

  .mapview__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mapview__list-item {
    display: grid;
    grid-template-columns: 180px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .mapview__list-item[hidden] {
    display: none;
  }

  .mapview__list-item:last-child {
    border-bottom: none;
  }

  .mapview__list-tag {
    color: var(--text-secondary);
  }

  .mapview__list-tag--event {
    color: var(--crimson-text);
  }

  .mapview__list-tag--planned {
    color: #9e9e9e;
  }

  .mapview__live-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--crimson-bright);
    margin-right: 0.4rem;
    animation: map-pulse-dot 1.6s var(--ease-out) infinite;
  }

  @keyframes map-pulse-dot {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .mapview__list-name {
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mapview__list-equipment {
    font-weight: 400;
    color: var(--text-secondary);
    font-size: 0.8rem;
  }

  .mapview__list-meta {
    color: var(--text-secondary);
    font-size: 0.85rem;
    text-align: right;
  }

  .mapview__list-request {
    color: var(--crimson-text);
    font-weight: 600;
  }

  .mapview__list-empty {
    padding: 2rem 1.25rem;
    color: var(--text-secondary);
    text-align: center;
  }

  @media (max-width: 640px) {
    .mapview__list-item {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .mapview__list-meta {
      text-align: left;
    }
  }

  /* 28px invisible hit area around every pin; the visible mark is centred
     inside it and stays small. */
  :global(.map-pin-hit),
  :global(.map-cluster-hit) {
    display: flex !important;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
  }

  :global(.map-pin) {
    display: block;
    width: 14px;
    height: 14px;
  }

  /* ○ Locations (permanent hubs): solid crimson circle */
  :global(.map-pin--location) {
    border-radius: 50%;
    background: var(--crimson-bright);
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px rgba(200, 16, 46, 0.4);
  }

  /* □ Planned (unconfirmed) hubs: small grey square, deliberately understated */
  :global(.map-pin--planned) {
    width: 11px;
    height: 11px;
    background: #6b6b6b;
    border: 2px solid #3a3a3a;
  }

  /* △ Events: hollow white triangle, reads as "temporary" next to the
     solid hub circles. SVG so the outline stays crisp at any zoom. */
  :global(.map-pin--event) {
    width: 16px;
    height: 15px;
  }

  :global(.map-pin--event svg) {
    display: block;
    overflow: visible;
  }

  :global(.map-pin--event path) {
    fill: rgba(10, 10, 10, 0.55);
    stroke: #fff;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  /* A live event's triangle fills crimson and pulses; upcoming and past
     events stay a plain white outline */
  :global(.map-pin--event.map-pin--pulse path) {
    fill: var(--crimson-bright);
    stroke: #fff;
  }

  :global(.map-pin--pulse) {
    position: relative;
  }

  :global(.map-pin--pulse::after) {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: var(--crimson-bright);
    opacity: 0.6;
    z-index: -1;
    animation: map-pulse 1.8s var(--ease-out) infinite;
  }

  /* Cluster bubble: dark disc, crimson ring, white count — on-brand rather
     than the plugin's default traffic-light colours. */
  :global(.map-cluster) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--bg-base);
    border: 2px solid var(--crimson-bright);
    box-shadow: 0 0 0 4px rgba(200, 16, 46, 0.25);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1;
  }

  :global(.leaflet-popup-content-wrapper),
  :global(.leaflet-popup-tip) {
    background: var(--surface-alt);
    color: var(--text-primary-dim);
    border: 1px solid var(--border);
  }

  :global(.leaflet-popup-content) {
    font-family: var(--font-body);
    font-size: 0.85rem;
  }

  :global(.leaflet-popup-content a) {
    color: var(--crimson-text);
    font-weight: 600;
  }

  :global(.popup-live) {
    color: var(--crimson-text);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  @keyframes map-pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
</style>
