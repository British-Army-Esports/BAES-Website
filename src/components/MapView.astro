---
import 'leaflet/dist/leaflet.css';
import { getCollection } from 'astro:content';
import { formatEventDate } from '../lib/eventDate';

export interface Props {
  // Locations (permanent sites) always show. Events are optional — the
  // dedicated /locations page turns them off since "Locations" means
  // permanent sites specifically; the homepage keeps both for a quick
  // combined overview.
  showEvents?: boolean;
}

const { showEvents = true } = Astro.props;

const allLocations = await getCollection('locations', ({ data }) => data.active);
// Inactive locations are hubs we know about but haven't confirmed/gone live
// with yet (see the "active: false" note on their content files) — shown as
// grey "planned" markers, distinct from confirmed active hubs.
const plannedLocations = await getCollection('locations', ({ data }) => !data.active);
// Only fixtures with a fixed physical venue can be plotted here — online
// qualifiers and not-yet-located internal fixtures aren't shown on this map.
const allEvents = showEvents
  ? (await getCollection('events')).filter((event) => event.data.location)
  : [];

const locationPoints = allLocations.map((loc) => ({
  id: loc.id,
  name: loc.data.name,
  type: loc.data.type,
  address: loc.data.address,
  equipment: loc.data.equipment ?? [],
  lat: loc.data.location.lat,
  long: loc.data.location.long,
}));

const plannedPoints = plannedLocations.map((loc) => ({
  id: loc.id,
  name: loc.data.name,
  address: loc.data.address,
  status: loc.data.status,
  lat: loc.data.location.lat,
  long: loc.data.location.long,
}));

const now = Date.now();
const eventPoints = allEvents.map((event) => {
  const start = event.data.date.getTime();
  const end = event.data.endDate?.getTime() ?? start + 24 * 60 * 60 * 1000;
  // "Live now" means genuinely in progress right now — not just upcoming.
  // A provisional/TBC date can't honestly be shown as live (same rule as
  // the Ticker), and community-outreach presences don't have a "live"
  // competitive result to show either.
  const isLive =
    event.data.presenceType !== 'community-outreach' &&
    (event.data.dateStatus ?? 'confirmed') === 'confirmed' &&
    now >= start &&
    now <= end;
  return {
    id: event.id,
    name: event.data.title,
    scale: event.data.scale,
    presenceType: event.data.presenceType,
    dateLabel: formatEventDate(event.data).text,
    locationName: event.data.location!.name,
    lat: event.data.location!.lat,
    long: event.data.location!.long,
    live: isLive,
  };
});

const typeLabels: Record<string, string> = {
  'arena-venue': 'Arena Venue',
  'competition-venue': 'Competition Venue',
  'training-venue': 'Training Venue',
  'limited-setup': 'Limited Setup',
  unspecified: 'Gaming Room',
};
---

<section class="mapview">
  <div class="mapview__controls">
    <div class="mapview__group" role="group" aria-label="Map layers">
      <button type="button" class="mapview__pill is-active" data-layer="locations">
        Our Locations
      </button>
      {
        plannedPoints.length > 0 && (
          <button type="button" class="mapview__pill is-active" data-layer="planned">
            Planned
          </button>
        )
      }
      {
        showEvents && (
          <button type="button" class="mapview__pill is-active" data-layer="events">
            Events
          </button>
        )
      }
    </div>
    <div class="mapview__group" role="group" aria-label="View mode">
      <button type="button" class="mapview__pill is-active" data-view="map">View as Map</button>
      <button type="button" class="mapview__pill" data-view="list">View as List</button>
    </div>
  </div>

  <div id="baes-map" class="mapview__map"></div>

  <ul class="mapview__list" hidden>
    {
      locationPoints.map((loc) => (
        <li class="mapview__list-item">
          <span class="mapview__list-tag label">{typeLabels[loc.type] ?? loc.type}</span>
          <span class="mapview__list-name">
            {loc.name}
            {loc.equipment.length > 0 && (
              <span class="mapview__list-equipment">{loc.equipment.join(' · ')}</span>
            )}
          </span>
          <span class="mapview__list-meta">
            {loc.address}
            {' · '}
            <a href={`/locations/${loc.id}/request`} class="mapview__list-request">
              Request Access
            </a>
          </span>
        </li>
      ))
    }
    {
      plannedPoints.map((loc) => (
        <li class="mapview__list-item">
          <span class="mapview__list-tag label mapview__list-tag--planned">Planned</span>
          <span class="mapview__list-name">{loc.name}</span>
          <span class="mapview__list-meta">{loc.address}</span>
        </li>
      ))
    }
    {
      eventPoints.map((event) => (
        <li class="mapview__list-item">
          <span class="mapview__list-tag label mapview__list-tag--event">
            {event.live && <span class="mapview__live-dot" aria-label="Live now" />}
            {event.scale.replace(/-/g, ' ')}
          </span>
          <span class="mapview__list-name">{event.name}</span>
          <span class="mapview__list-meta">
            {event.locationName} · {event.dateLabel}
          </span>
        </li>
      ))
    }
    {
      locationPoints.length === 0 && plannedPoints.length === 0 && eventPoints.length === 0 && (
        <li class="mapview__list-empty">No locations or events published yet.</li>
      )
    }
  </ul>
</section>

<script type="application/json" id="baes-map-data" set:html={JSON.stringify({ locationPoints, plannedPoints, eventPoints, typeLabels })}></script>

<script>
  import L from 'leaflet';

  const dataEl = document.getElementById('baes-map-data');
  const { locationPoints, plannedPoints, eventPoints, typeLabels } = JSON.parse(dataEl.textContent);

  {
    const map = L.map('baes-map', {
      zoomControl: true,
      attributionControl: true,
      minZoom: 4,
    });

    // Standard OSM tiles rather than a niche third-party dark-tile CDN —
    // tile.openstreetmap.org is about as universally allowlisted as a tile
    // host gets, which matters on locked-down networks. Dark styling is
    // faked with a CSS filter on the tile pane instead (see <style> below).
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      subdomains: 'abc',
      maxZoom: 19,
    }).addTo(map);

    // Strip Leaflet's own "Leaflet" self-attribution link — it points to
    // leafletjs.com, whose homepage carries a Ukraine solidarity banner.
    // Not appropriate to link to from an official Army site regardless of
    // the politics involved. OSM attribution above still satisfies their
    // usage terms.
    map.attributionControl.setPrefix(false);

    // Locations (permanent) are solid crimson pins. Events are hollow
    // white-ring pins so the two are visually distinct at a glance — only a
    // genuinely *live* event gets the pulsing ring, never just "upcoming".
    const makeIcon = (variant, pulsing) =>
      L.divIcon({
        className: '',
        html: `<span class="map-pin map-pin--${variant}${pulsing ? ' map-pin--pulse' : ''}"></span>`,
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      });

    const locationsLayer = L.layerGroup(
      locationPoints.map((loc) =>
        L.marker([loc.lat, loc.long], { icon: makeIcon('location', false) }).bindPopup(
          `<strong>${loc.name}</strong><br>${typeLabels[loc.type] ?? loc.type}<br>${loc.address}<br><a href="/locations/${loc.id}/request">Request Access →</a>`,
        ),
      ),
    );

    // Planned hubs: known about, not yet confirmed/active. Grey pins, no
    // request link since no such page exists for them yet.
    const plannedLayer = L.layerGroup(
      plannedPoints.map((loc) =>
        L.marker([loc.lat, loc.long], { icon: makeIcon('planned', false) }).bindPopup(
          `<strong>${loc.name}</strong><br>Planned (unconfirmed)<br>${loc.address}`,
        ),
      ),
    );

    const eventsLayer = L.layerGroup(
      eventPoints.map((event) =>
        L.marker([event.lat, event.long], { icon: makeIcon('event', event.live) }).bindPopup(
          `<strong>${event.name}</strong>${event.live ? ' <span class="popup-live">● LIVE NOW</span>' : ''}<br>${event.locationName}<br>${event.dateLabel}`,
        ),
      ),
    );

    locationsLayer.addTo(map);
    plannedLayer.addTo(map);
    eventsLayer.addTo(map);

    // Frame the initial view on permanent locations only, not events. Events
    // can be anywhere in the world (C.O.D.E Bowl VII is in San Diego), and
    // including them here would drag the initial view off the UK to fit an
    // outlier. Locations are always UK-based, so they give a stable, sane
    // home view every time; international event pins are still on the map,
    // just reachable by panning rather than driving the initial framing.
    const homeRegionPoints = [...locationPoints, ...plannedPoints];
    if (homeRegionPoints.length > 0) {
      map.fitBounds(
        homeRegionPoints.map((p) => [p.lat, p.long]),
        { padding: [40, 40], maxZoom: 12 },
      );
    } else if (eventPoints.length > 0) {
      map.fitBounds(
        eventPoints.map((p) => [p.lat, p.long]),
        { padding: [40, 40], maxZoom: 12 },
      );
    } else {
      map.setView([54.5, -3], 6);
    }

    const layersByName = { locations: locationsLayer, planned: plannedLayer, events: eventsLayer };
    document.querySelectorAll('[data-layer]').forEach((btn) => {
      btn.addEventListener('click', () => {
        btn.classList.toggle('is-active');
        const layer = layersByName[btn.dataset.layer];
        if (btn.classList.contains('is-active')) {
          layer.addTo(map);
        } else {
          map.removeLayer(layer);
        }
      });
    });

    const mapEl = document.getElementById('baes-map');
    const listEl = document.querySelector('.mapview__list');
    document.querySelectorAll('[data-view]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('[data-view]').forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        const showMap = btn.dataset.view === 'map';
        mapEl.hidden = !showMap;
        listEl.hidden = showMap;
        if (showMap) map.invalidateSize();
      });
    });
  }
</script>

<style>
  .mapview {
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .mapview__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .mapview__group {
    display: flex;
    gap: 0.5rem;
  }

  .mapview__pill {
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .mapview__pill.is-active {
    color: var(--crimson-bright);
    border-color: var(--crimson);
  }

  .mapview__map {
    height: 480px;
    width: 100%;
    background: #0d0d0d;
  }

  /* Fake a dark basemap from standard (light) OSM tiles via CSS filter,
     rather than depending on a separately-hosted dark-tile CDN. Scoped to
     the tile pane only so markers/popups/controls keep their real colours. */
  :global(.mapview__map .leaflet-tile-pane) {
    filter: invert(1) hue-rotate(180deg) brightness(0.95) contrast(0.9) saturate(0.6);
  }

  .mapview__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mapview__list-item {
    display: grid;
    grid-template-columns: 180px 1fr auto;
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .mapview__list-item:last-child {
    border-bottom: none;
  }

  .mapview__list-tag {
    color: var(--text-secondary);
  }

  .mapview__list-tag--event {
    color: var(--crimson-bright);
  }

  .mapview__list-tag--planned {
    color: #9e9e9e;
  }

  .mapview__live-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--crimson-bright);
    margin-right: 0.4rem;
    animation: map-pulse-dot 1.6s var(--ease-out) infinite;
  }

  @keyframes map-pulse-dot {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }

  .mapview__list-name {
    font-weight: 600;
    color: var(--text-primary);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mapview__list-equipment {
    font-weight: 400;
    color: var(--text-secondary);
    font-size: 0.8rem;
  }

  .mapview__list-meta {
    color: var(--text-secondary);
    font-size: 0.85rem;
    text-align: right;
  }

  .mapview__list-request {
    color: var(--crimson-bright);
    font-weight: 600;
  }

  .mapview__list-empty {
    padding: 2rem 1.25rem;
    color: var(--text-secondary);
    text-align: center;
  }

  @media (max-width: 640px) {
    .mapview__list-item {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }

    .mapview__list-meta {
      text-align: left;
    }
  }

  :global(.map-pin) {
    display: block;
    width: 14px;
    height: 14px;
    border-radius: 50%;
  }

  /* Locations (permanent): solid crimson fill */
  :global(.map-pin--location) {
    background: var(--crimson-bright);
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px rgba(200, 16, 46, 0.4);
  }

  /* Planned (unconfirmed) hubs: dim grey, deliberately understated */
  :global(.map-pin--planned) {
    width: 10px;
    height: 10px;
    background: #6b6b6b;
    border: 2px solid #3a3a3a;
  }

  /* Events (temporary): hollow white ring — visually distinct from a
     permanent location at a glance */
  :global(.map-pin--event) {
    background: transparent;
    border: 2px solid #fff;
    box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.25);
  }

  /* A live event's ring turns crimson and pulses; a non-live one stays a
     plain white outline, whether it's upcoming or past */
  :global(.map-pin--event.map-pin--pulse) {
    border-color: var(--crimson-bright);
    background: var(--crimson-bright);
  }

  :global(.map-pin--pulse) {
    position: relative;
  }

  :global(.map-pin--pulse::after) {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: var(--crimson-bright);
    opacity: 0.6;
    animation: map-pulse 1.8s var(--ease-out) infinite;
  }

  :global(.leaflet-popup-content-wrapper),
  :global(.leaflet-popup-tip) {
    background: var(--surface-alt);
    color: var(--text-primary-dim);
    border: 1px solid var(--border);
  }

  :global(.leaflet-popup-content) {
    font-family: var(--font-body);
    font-size: 0.85rem;
  }

  :global(.leaflet-popup-content a) {
    color: var(--crimson-bright);
    font-weight: 600;
  }

  :global(.popup-live) {
    color: var(--crimson-bright);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  @keyframes map-pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
</style>
