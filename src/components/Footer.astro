---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__top">
    <div class="footer__brand">
      <a href="/" class="footer__brand-link">
        <img class="footer__crest" src="/logos/brand/baes-crest.png" alt="" width="1164" height="1460" />
        <span class="footer__wordmark">
          <span class="footer__wordmark-white">BRITISH ARMY</span>
          <span class="footer__wordmark-crimson">ESPORTS</span>
        </span>
      </a>
      <p class="footer__tagline label">Adaptability. Excellence. Together.</p>
      <div class="footer__social">
        <a href="https://x.com/BritArmyesports" aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2h3.3l-7.2 8.2L23.5 22h-6.6l-5.2-6.8L5.8 22H2.5l7.7-8.8L1.5 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.8L7.4 3.9H5.5L17.7 20Z"/></svg>
        </a>
        <a href="https://www.twitch.tv/britisharmyesports" aria-label="Twitch" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.2 2 2 7.4v13.3h5.1V24h3l3-3.3h4.4L23 15.4V2H4.2Zm16.7 12.4-3.4 3.4h-4.6l-3 3.3v-3.3H5.7V4.1h15.2v10.3Z"/><path d="M17.4 7.1h1.9v5.7h-1.9zM12 7.1h1.9v5.7H12z"/></svg>
        </a>
        <a href="https://www.youtube.com/c/BritishArmyEsports" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5V8.5l6.3 3.5-6.3 3.5Z"/></svg>
        </a>
        <a href="https://discord.gg/D5SrQ6xAdw" aria-label="Discord" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 5.3A18 18 0 0 0 15.9 4l-.3.6a15 15 0 0 1 3.8 1.4 15.6 15.6 0 0 0-13 0 15 15 0 0 1 3.8-1.4L10 4a18 18 0 0 0-4.4 1.3C2.6 9.1 1.9 12.8 2.2 16.4a18.2 18.2 0 0 0 5.5 2.7l.9-1.4a11.6 11.6 0 0 1-1.9-.9l.5-.4a13 13 0 0 0 11.6 0l.5.4a11.6 11.6 0 0 1-1.9.9l.9 1.4a18.1 18.1 0 0 0 5.5-2.7c.4-4.1-.6-7.8-3.5-11.1ZM9.7 14.3c-.8 0-1.5-.8-1.5-1.7s.7-1.7 1.5-1.7 1.6.8 1.5 1.7c0 1-.7 1.7-1.5 1.7Zm5.1 0c-.8 0-1.5-.8-1.5-1.7s.7-1.7 1.5-1.7 1.6.8 1.5 1.7c0 1-.6 1.7-1.5 1.7Z"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer__links" aria-label="Community">
      <p class="footer__col-heading label">Community</p>
      <a href="https://discord.gg/D5SrQ6xAdw" target="_blank" rel="noopener noreferrer">Discord</a>
      <a href="https://www.twitch.tv/britisharmyesports" target="_blank" rel="noopener noreferrer">Twitch</a>
      <a href="https://www.youtube.com/c/BritishArmyEsports" target="_blank" rel="noopener noreferrer">YouTube</a>
      <a href="https://x.com/BritArmyesports" target="_blank" rel="noopener noreferrer">X (Twitter)</a>
    </nav>

    <nav class="footer__links" aria-label="UK Military esports ecosystem">
      <p class="footer__col-heading label">UK Military Esports Ecosystem</p>
      <a href="https://britisharmysport.com/army-e-sports/" target="_blank" rel="noopener noreferrer">Army Sport Esports</a>
      <a href="https://www.twitch.tv/rafesports" target="_blank" rel="noopener noreferrer">RAF Esports</a>
      <a href="https://www.twitch.tv/royalnavyesports" target="_blank" rel="noopener noreferrer">Royal Navy Esports</a>
      <a href="http://ideg.gg/" target="_blank" rel="noopener noreferrer">IDEG (Intl. Defence Esports Games)</a>
      <a href="https://bfbsesports.com/" target="_blank" rel="noopener noreferrer">BFBS Esports</a>
      <a href="https://ukveterans.gg/" target="_blank" rel="noopener noreferrer">UK Veterans Gaming</a>
    </nav>
  </div>

  <div class="container footer__sponsors">
    <p class="footer__col-heading label">Partners</p>
    <div class="footer__sponsor-row">
      <a href="/sponsors" class="footer__sponsor-chip clip-tl-sm">
        <img src="/logos/sponsors/wired2fire.png" alt="Wired2Fire" />
      </a>
      <a href="/sponsors" class="footer__sponsor-chip clip-tl-sm">
        <img src="/logos/sponsors/coolermaster.svg" alt="Cooler Master" />
      </a>
      <a href="/sponsors" class="footer__sponsor-more">All Partners →</a>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>&copy; Crown copyright {year}. British Army Esports sits under Army Sport / ASCB governance.</p>
    <a href="/feedback" class="footer__feedback-link">Feedback</a>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    background: var(--bg-base-alt);
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: clamp(2rem, 5vw, 3rem);
    padding-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-bottom: clamp(2rem, 5vw, 3rem);
  }

  .footer__brand-link {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .footer__crest {
    height: 40px;
    width: auto;
  }

  .footer__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .footer__wordmark-white {
    color: var(--text-primary);
    font-size: 0.75rem;
  }

  .footer__wordmark-crimson {
    color: var(--crimson-bright);
    font-size: 1.05rem;
  }

  .footer__tagline {
    margin: 1rem 0 0;
  }

  .footer__social {
    display: flex;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .footer__social a {
    color: var(--text-secondary-alt);
    transition: color 0.2s var(--ease-out);
  }

  .footer__social a:hover {
    color: var(--crimson-bright);
  }

  .footer__social svg {
    width: 18px;
    height: 18px;
  }

  .footer__col-heading {
    margin: 0 0 1rem;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .footer__links a {
    color: var(--text-secondary-alt);
    font-size: 0.9rem;
    transition: color 0.2s var(--ease-out);
  }

  .footer__links a:hover {
    color: var(--crimson-bright);
  }

  .footer__sponsors {
    padding-top: 1.75rem;
    padding-bottom: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .footer__sponsor-row {
    display: flex;
    align-items: center;
    gap: clamp(2rem, 6vw, 4rem);
    flex-wrap: wrap;
  }

  /* Sponsor logos vary in colour — some are near-black. A light chip behind
     each one guarantees legibility regardless of the logo's own palette,
     rather than relying on filters that don't help a black-on-black logo. */
  .footer__sponsor-chip {
    display: inline-flex;
    align-items: center;
    background: #f2f2f2;
    padding: 0.6rem 1.25rem;
    transition: transform 0.2s var(--ease-out);
  }

  .footer__sponsor-chip:hover {
    transform: translateY(-2px);
  }

  .footer__sponsor-row img {
    height: 24px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
  }

  .footer__sponsor-more {
    color: var(--crimson-bright);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .footer__bottom {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .footer__bottom p {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.8rem;
  }

  .footer__feedback-link {
    color: var(--text-secondary-alt);
    font-weight: 600;
    font-size: 0.8rem;
    flex-shrink: 0;
    transition: color 0.2s var(--ease-out);
  }

  .footer__feedback-link:hover {
    color: var(--crimson-bright);
  }

  @media (max-width: 700px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
  }
</style>
