---
export interface EventCardData {
  id: string;
  title: string;
  scale: string;
  team?: string;
  presenceType: string;
  disciplineIds: string[];
  disciplineNames: string[];
  accentColor?: string;
  locationName: string;
  externalLink?: string;
  resultsSummary?: string;
  text: string;
  badge: 'confirmed' | 'provisional' | 'tbc';
}

export interface Props {
  event: EventCardData;
  scaleLabels: Record<string, string>;
  teamLabels: Record<string, string>;
  live?: boolean;
  // Currently within its date range like `live`, but spans too long (a
  // season/qualifier run) to honestly badge as "happening right now" — a
  // calmer, non-pulsing indicator instead. Mutually exclusive with `live`
  // in practice (a card is one or the other, never both).
  ongoing?: boolean;
}

const { event, scaleLabels, teamLabels, live = false, ongoing = false } = Astro.props;
const accent = event.accentColor || '#c8102e';
---

<div
  class:list={['event-card', 'clip-tl', { 'event-card--live': live, 'event-card--ongoing': ongoing }]}
  data-disciplines={event.disciplineIds.join(',')}
  data-scale={event.scale}
  data-presence={event.presenceType}
  style={`--accent: ${accent}`}
>
  <div class="event-card__bar"></div>
  <div class="event-card__corner-glow"></div>
  <div class="event-card__body">
    <div class="event-card__top">
      <span class:list={['event-card__date', `event-card__date--${event.badge}`]}>{event.text}</span>
      {live && <span class="event-card__live">● LIVE</span>}
      {ongoing && <span class="event-card__ongoing">📺 Streaming Now</span>}
    </div>
    <h3 class="event-card__title">
      {
        event.externalLink ? (
          <a href={event.externalLink} target="_blank" rel="noopener noreferrer">
            {event.title} ↗
          </a>
        ) : (
          <a href={`/events/${event.id}`}>{event.title}</a>
        )
      }
    </h3>
    <p class="event-card__scale label">
      {scaleLabels[event.scale]}
      {event.team && ` · ${teamLabels[event.team]}`}
      {event.disciplineNames.length > 0 && ` · ${event.disciplineNames.join(', ')}`}
    </p>
    {
      event.resultsSummary && (
        <div class="event-card__result">
          <span class="event-card__result-label label">Result</span>
          <span class="event-card__result-text">{event.resultsSummary}</span>
        </div>
      )
    }
    <p class="event-card__location">{event.locationName}</p>
  </div>
</div>

<style>
  .event-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(165deg, var(--surface) 0%, var(--bg-base-alt) 100%);
    border: 1px solid transparent;
    border-image: linear-gradient(140deg, var(--accent) 0%, var(--border) 40%, var(--border) 100%) 1;
    overflow: hidden;
    transition: transform 0.2s var(--ease-out), border-image 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }

  .event-card[hidden] {
    display: none;
  }

  .event-card:hover {
    transform: translateY(-3px);
    border-image: linear-gradient(140deg, var(--accent) 0%, var(--accent) 70%, var(--border) 100%) 1;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45), 0 0 22px -6px var(--accent);
  }

  .event-card--live {
    border-image: none;
    border-color: var(--crimson);
    box-shadow: 0 0 0 1px var(--crimson), 0 0 24px -4px var(--crimson-bright);
  }

  .event-card__corner-glow {
    position: absolute;
    top: -20px;
    right: -20px;
    width: 90px;
    height: 90px;
    background: radial-gradient(circle, var(--accent) 0%, transparent 72%);
    opacity: 0.25;
    pointer-events: none;
  }

  .event-card__bar {
    height: 4px;
    background: linear-gradient(90deg, var(--accent) 0%, transparent 130%);
  }

  .event-card__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .event-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .event-card__date {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .event-card__date--provisional,
  .event-card__date--tbc {
    color: var(--text-secondary);
    font-style: italic;
  }

  .event-card__live {
    color: var(--crimson-bright);
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .event-card__ongoing {
    color: var(--text-secondary-alt);
    font-weight: 600;
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    flex-shrink: 0;
  }

  .event-card--ongoing {
    border-image: none;
    border-color: var(--accent);
  }

  .event-card__title {
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .event-card__title a {
    color: inherit;
  }

  .event-card__title a:hover {
    color: var(--accent);
  }

  .event-card__scale {
    color: var(--text-secondary);
  }

  .event-card__result {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: rgba(200, 16, 46, 0.08);
    border-left: 2px solid var(--crimson);
    padding: 0.5rem 0.75rem;
  }

  .event-card__result-label {
    color: var(--crimson-bright);
  }

  .event-card__result-text {
    color: var(--text-primary-dim);
    font-size: 0.85rem;
  }

  .event-card__location {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin: auto 0 0;
    padding-top: 0.25rem;
  }
</style>
