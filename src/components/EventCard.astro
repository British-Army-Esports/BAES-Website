---
export interface EventCardData {
  id: string;
  title: string;
  scale: string;
  team?: string;
  disciplineIds: string[];
  disciplineNames: string[];
  accentColor?: string;
  locationName: string;
  externalLink?: string;
  resultsSummary?: string;
  text: string;
  badge: 'confirmed' | 'provisional' | 'tbc';
}

export interface Props {
  event: EventCardData;
  scaleLabels: Record<string, string>;
  teamLabels: Record<string, string>;
  live?: boolean;
}

const { event, scaleLabels, teamLabels, live = false } = Astro.props;
const accent = event.accentColor || '#c8102e';
---

<div
  class:list={['event-card', 'clip-tl', { 'event-card--live': live }]}
  data-disciplines={event.disciplineIds.join(',')}
  style={`--accent: ${accent}`}
>
  <div class="event-card__bar"></div>
  <div class="event-card__body">
    <div class="event-card__top">
      <span class:list={['event-card__date', `event-card__date--${event.badge}`]}>{event.text}</span>
      {live && <span class="event-card__live">● LIVE</span>}
    </div>
    <h3 class="event-card__title">
      {
        event.externalLink ? (
          <a href={event.externalLink} target="_blank" rel="noopener noreferrer">
            {event.title} ↗
          </a>
        ) : (
          event.title
        )
      }
    </h3>
    <p class="event-card__scale label">
      {scaleLabels[event.scale]}
      {event.team && ` · ${teamLabels[event.team]}`}
      {event.disciplineNames.length > 0 && ` · ${event.disciplineNames.join(', ')}`}
    </p>
    {
      event.resultsSummary && (
        <div class="event-card__result">
          <span class="event-card__result-label label">Result</span>
          <span class="event-card__result-text">{event.resultsSummary}</span>
        </div>
      )
    }
    <p class="event-card__location">{event.locationName}</p>
  </div>
</div>

<style>
  .event-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
    transition: transform 0.2s var(--ease-out), border-color 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }

  .event-card:hover {
    transform: translateY(-3px);
    border-color: #3a3a3a;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }

  .event-card--live {
    border-color: var(--crimson);
    box-shadow: 0 0 0 1px var(--crimson);
  }

  .event-card__bar {
    height: 4px;
    background: var(--accent);
  }

  .event-card__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .event-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .event-card__date {
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--text-primary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .event-card__date--provisional,
  .event-card__date--tbc {
    color: var(--text-secondary);
    font-style: italic;
  }

  .event-card__live {
    color: var(--crimson-bright);
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .event-card__title {
    font-size: 1.1rem;
    line-height: 1.25;
  }

  .event-card__title a {
    color: inherit;
  }

  .event-card__title a:hover {
    color: var(--accent);
  }

  .event-card__scale {
    color: var(--text-secondary);
  }

  .event-card__result {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: rgba(200, 16, 46, 0.08);
    border-left: 2px solid var(--crimson);
    padding: 0.5rem 0.75rem;
  }

  .event-card__result-label {
    color: var(--crimson-bright);
  }

  .event-card__result-text {
    color: var(--text-primary-dim);
    font-size: 0.85rem;
  }

  .event-card__location {
    color: var(--text-secondary);
    font-size: 0.85rem;
    margin: auto 0 0;
    padding-top: 0.25rem;
  }
</style>
