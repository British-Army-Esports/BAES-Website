---
export interface Props {
  active?: string;
}
const { active } = Astro.props;

const links = [
  { label: 'Disciplines', href: '/disciplines' },
  { label: 'Corps', href: '/corps' },
  { label: 'Events', href: '/events' },
  { label: 'News', href: '/news' },
  { label: 'Creators', href: '/creators' },
  { label: 'Locations', href: '/locations' },
  { label: 'About', href: '/about' },
];
---

<header class="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href="/">
      <img class="nav__crest" src="/logos/brand/baes-crest.png" alt="" width="1164" height="1460" />
      <span class="nav__wordmark">
        <span class="nav__wordmark-line">
          <span class="nav__wordmark-white">BRITISH ARMY</span>
        </span>
        <span class="nav__wordmark-crimson">ESPORTS</span>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav__toggle-input" />
    <label for="nav-toggle" class="nav__toggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav__links" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['nav__link', { 'nav__link--active': active === link.label }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav__actions">
      <a href="/join" class="nav__cta clip-tl-sm">Join Us</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 72px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .nav__crest {
    height: 46px;
    width: auto;
  }

  .nav__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .nav__wordmark-white,
  .nav__wordmark-crimson {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .nav__wordmark-white {
    color: var(--text-primary);
    font-size: 0.8rem;
  }

  .nav__wordmark-crimson {
    color: var(--crimson-bright);
    font-size: 1.15rem;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin: 0 auto;
  }

  .nav__link {
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    color: var(--text-secondary-alt);
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
    white-space: nowrap;
  }

  .nav__link:hover {
    color: var(--text-primary);
  }

  .nav__link--active {
    color: var(--crimson-bright);
    border-bottom-color: var(--crimson-bright);
  }

  .nav__actions {
    flex-shrink: 0;
  }

  .nav__cta {
    display: inline-block;
    background: var(--crimson);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    padding: 0.65rem 1.25rem;
    transition: background 0.2s var(--ease-out);
  }

  .nav__cta:hover {
    background: var(--crimson-bright);
  }

  .nav__toggle-input {
    display: none;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    margin-left: auto;
    padding: 8px;
  }

  .nav__toggle span {
    width: 22px;
    height: 2px;
    background: var(--text-primary);
  }

  @media (max-width: 860px) {
    .nav__toggle {
      display: flex;
    }

    .nav__actions {
      display: none;
    }

    .nav__links {
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--bg-base-alt);
      border-bottom: 1px solid var(--border);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s var(--ease-out);
    }

    .nav__toggle-input:checked ~ .nav__links {
      max-height: 480px;
    }

    .nav__link {
      width: 100%;
      padding: 0.9rem clamp(1rem, 3vw, 2.5rem);
      border-bottom: 1px solid var(--border);
      border-left: 2px solid transparent;
    }

    .nav__link--active {
      border-bottom: 1px solid var(--border);
      border-left-color: var(--crimson-bright);
    }
  }
</style>
