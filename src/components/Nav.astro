---
export interface Props {
  active?: string;
}
const { active } = Astro.props;

const links = [
  { label: 'Disciplines', href: '/disciplines' },
  { label: 'Corps', href: '/corps' },
  { label: 'Events', href: '/events' },
  { label: 'News', href: '/news' },
  { label: 'Content', href: '/content' },
  { label: 'Locations', href: '/locations' },
  { label: 'About', href: '/about' },
];
---

<header class="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href="/">
      <img class="nav__crest" src="/logos/brand/baes-crest.png" alt="" width="1164" height="1460" />
      <span class="nav__wordmark">
        <span class="nav__wordmark-line">
          <span class="nav__wordmark-white">BRITISH ARMY</span>
        </span>
        <span class="nav__wordmark-crimson">ESPORTS</span>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav__toggle-input" />
    <label for="nav-toggle" class="nav__toggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="nav__links" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={['nav__link', { 'nav__link--active': active === link.label }]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav__actions">
      <a href="https://x.com/BritArmyesports" class="nav__social" aria-label="X (Twitter)" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2h3.3l-7.2 8.2L23.5 22h-6.6l-5.2-6.8L5.8 22H2.5l7.7-8.8L1.5 2h6.8l4.7 6.2L18.9 2Zm-1.2 18h1.8L7.4 3.9H5.5L17.7 20Z"/></svg>
      </a>
      <a href="https://www.twitch.tv/britisharmyesports" class="nav__social" aria-label="Twitch" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.2 2 2 7.4v13.3h5.1V24h3l3-3.3h4.4L23 15.4V2H4.2Zm16.7 12.4-3.4 3.4h-4.6l-3 3.3v-3.3H5.7V4.1h15.2v10.3Z"/><path d="M17.4 7.1h1.9v5.7h-1.9zM12 7.1h1.9v5.7H12z"/></svg>
      </a>
      <a href="https://www.youtube.com/c/BritishArmyEsports" class="nav__social" aria-label="YouTube" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5V8.5l6.3 3.5-6.3 3.5Z"/></svg>
      </a>
      <a href="https://discord.gg/D5SrQ6xAdw" class="nav__social" aria-label="Discord" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.3 5.3A18 18 0 0 0 15.9 4l-.3.6a15 15 0 0 1 3.8 1.4 15.6 15.6 0 0 0-13 0 15 15 0 0 1 3.8-1.4L10 4a18 18 0 0 0-4.4 1.3C2.6 9.1 1.9 12.8 2.2 16.4a18.2 18.2 0 0 0 5.5 2.7l.9-1.4a11.6 11.6 0 0 1-1.9-.9l.5-.4a13 13 0 0 0 11.6 0l.5.4a11.6 11.6 0 0 1-1.9.9l.9 1.4a18.1 18.1 0 0 0 5.5-2.7c.4-4.1-.6-7.8-3.5-11.1ZM9.7 14.3c-.8 0-1.5-.8-1.5-1.7s.7-1.7 1.5-1.7 1.6.8 1.5 1.7c0 1-.7 1.7-1.5 1.7Zm5.1 0c-.8 0-1.5-.8-1.5-1.7s.7-1.7 1.5-1.7 1.6.8 1.5 1.7c0 1-.6 1.7-1.5 1.7Z"/></svg>
      </a>
      <a href="/join" class="nav__cta clip-tl-sm">Get Involved</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 10, 10, 0.88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 72px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .nav__crest {
    height: 46px;
    width: auto;
  }

  .nav__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }

  .nav__wordmark-white,
  .nav__wordmark-crimson {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .nav__wordmark-white {
    color: var(--text-primary);
    font-size: 0.8rem;
  }

  .nav__wordmark-crimson {
    color: var(--crimson-bright);
    font-size: 1.15rem;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin: 0 auto;
  }

  .nav__link {
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.75rem;
    color: var(--text-secondary-alt);
    padding-bottom: 4px;
    border-bottom: 2px solid transparent;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
    white-space: nowrap;
  }

  .nav__link:hover {
    color: var(--text-primary);
  }

  .nav__link--active {
    color: var(--crimson-bright);
    border-bottom-color: var(--crimson-bright);
  }

  .nav__actions {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav__social {
    display: flex;
    color: var(--text-secondary-alt);
    transition: color 0.2s var(--ease-out);
  }

  .nav__social svg {
    width: 18px;
    height: 18px;
  }

  .nav__social:hover {
    color: var(--crimson-bright);
  }

  .nav__cta {
    display: inline-block;
    background: var(--crimson);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    padding: 0.65rem 1.25rem;
    transition: background 0.2s var(--ease-out);
  }

  .nav__cta:hover {
    background: var(--crimson-bright);
  }

  .nav__toggle-input {
    display: none;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    margin-left: auto;
    padding: 8px;
  }

  .nav__toggle span {
    width: 22px;
    height: 2px;
    background: var(--text-primary);
  }

  @media (max-width: 860px) {
    .nav__toggle {
      display: flex;
    }

    .nav__actions {
      display: none;
    }

    .nav__links {
      position: absolute;
      top: 72px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--bg-base-alt);
      border-bottom: 1px solid var(--border);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s var(--ease-out);
    }

    .nav__toggle-input:checked ~ .nav__links {
      max-height: 480px;
    }

    .nav__link {
      width: 100%;
      padding: 0.9rem clamp(1rem, 3vw, 2.5rem);
      border-bottom: 1px solid var(--border);
      border-left: 2px solid transparent;
    }

    .nav__link--active {
      border-bottom: 1px solid var(--border);
      border-left-color: var(--crimson-bright);
    }
  }
</style>
