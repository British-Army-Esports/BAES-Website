---
// Shared photo grid + click-to-zoom lightbox, used on location request pages
// (with an optional AI-"enhanced" second set behind a toggle) and event
// detail pages and news articles (real photos only, no enhanced set).
// A photo is either a plain URL, or an object with a separate full-size URL
// for the lightbox and an optional caption (shown under the tile and in the
// lightbox).
//
// Only render one instance of this component per page — its script queries
// the document for all `[data-photo-open]`/`[data-photo-toggle]` elements,
// so a second instance on the same page would double up the wiring.
export type PhotoItem = string | { src: string; full?: string; caption?: string };

interface Props {
  photos?: PhotoItem[];
  enhancedPhotos?: string[];
}

const { photos: rawPhotos, enhancedPhotos } = Astro.props;
const photos = rawPhotos?.map((p) =>
  typeof p === 'string'
    ? { src: p, full: p, caption: undefined }
    : { src: p.src, full: p.full ?? p.src, caption: p.caption },
);
---

{
  ((photos && photos.length > 0) || (enhancedPhotos && enhancedPhotos.length > 0)) && (
    <div class="photo-section">
      <div class="photo-header">
        <p class="photo-banner" data-photo-banner hidden>
          🪄 AI-stylised vision — what we think this space <em>could</em> look like, not how it looks
          today.
        </p>
        {
          enhancedPhotos && enhancedPhotos.length > 0 && (
            <button type="button" class="photo-toggle" data-photo-toggle>
              ✨ Enhance!
            </button>
          )
        }
      </div>

      {
        photos && photos.length > 0 && (
          <div class="photo-grid" data-photo-grid="real">
            {photos.map((p) => (
              <button
                type="button"
                class="photo-grid__btn"
                data-photo-open={p.full}
                data-photo-caption={p.caption ?? ''}
                aria-label={p.caption ? `View photo: ${p.caption}` : 'View photo full size'}
              >
                <img class="photo-grid__img clip-tl-sm" src={p.src} alt={p.caption ?? ''} loading="lazy" />
                {p.caption && <span class="photo-grid__caption">{p.caption}</span>}
              </button>
            ))}
          </div>
        )
      }

      {
        enhancedPhotos && enhancedPhotos.length > 0 && (
          <div class="photo-grid" data-photo-grid="enhanced" hidden>
            {enhancedPhotos.map((src: string) => (
              <button type="button" class="photo-grid__btn" data-photo-open={src}>
                <img class="photo-grid__img clip-tl-sm" src={src} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )
      }
    </div>
  )
}

<div class="lightbox" data-lightbox hidden>
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close">
    ✕
  </button>
  <figure class="lightbox__figure">
    <img class="lightbox__img" data-lightbox-img src="" alt="" />
    <figcaption class="lightbox__caption" data-lightbox-caption hidden></figcaption>
  </figure>
</div>

<script>
  const toggle = document.querySelector('[data-photo-toggle]');
  const banner = document.querySelector('[data-photo-banner]');
  const realGrid = document.querySelector('[data-photo-grid="real"]');
  const enhancedGrid = document.querySelector('[data-photo-grid="enhanced"]');

  toggle?.addEventListener('click', () => {
    // Currently showing enhanced if its grid is visible (not hidden) —
    // toggle flips both grids and the banner together, and relabels the
    // button so it always describes what clicking it will do next.
    const showingEnhanced = enhancedGrid && !enhancedGrid.hidden;
    if (enhancedGrid) enhancedGrid.hidden = showingEnhanced;
    if (realGrid) realGrid.hidden = !showingEnhanced;
    if (banner) banner.hidden = showingEnhanced;
    toggle.textContent = showingEnhanced ? '✨ Enhance!' : '← Show Real Photos';
  });

  // Click-to-zoom: any photo (real or enhanced) opens full-size in a
  // lightbox overlay, closed via the ✕ button, clicking the backdrop, or
  // Escape.
  const lightbox = document.querySelector('[data-lightbox]');
  const lightboxImg = document.querySelector('[data-lightbox-img]');
  const lightboxClose = document.querySelector('[data-lightbox-close]');
  const lightboxCaption = document.querySelector<HTMLElement>('[data-lightbox-caption]');

  function openLightbox(src: string, caption = '') {
    if (!lightbox || !lightboxImg) return;
    (lightboxImg as HTMLImageElement).src = src;
    (lightboxImg as HTMLImageElement).alt = caption;
    if (lightboxCaption) {
      lightboxCaption.textContent = caption;
      lightboxCaption.hidden = !caption;
    }
    (lightbox as HTMLElement).hidden = false;
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImg) return;
    (lightbox as HTMLElement).hidden = true;
    (lightboxImg as HTMLImageElement).src = '';
  }

  document.querySelectorAll('[data-photo-open]').forEach((btn) => {
    btn.addEventListener('click', () =>
      openLightbox(btn.getAttribute('data-photo-open')!, btn.getAttribute('data-photo-caption') ?? ''),
    );
  });
  lightboxClose?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>

<style>
  .photo-section {
    margin: 0 0 1.5rem;
  }

  .photo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .photo-banner {
    margin: 0;
    color: var(--crimson-text);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .photo-banner[hidden] {
    display: none;
  }

  .photo-banner em {
    font-style: italic;
  }

  .photo-toggle {
    flex-shrink: 0;
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary-alt);
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.7rem;
    padding: 0.4rem 0.8rem;
    cursor: pointer;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .photo-toggle:hover {
    color: var(--crimson-text);
    border-color: var(--crimson);
  }

  .photo-grid {
    display: grid;
    /* auto-fit, not auto-fill: with only one or two photos (the common
       case), auto-fit collapses the empty tracks a fixed-count grid would
       otherwise leave, letting the real photos grow to fill the row
       instead of sitting at minimum size like thumbnails. */
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.6rem;
  }

  .photo-grid[hidden] {
    display: none;
  }

  .photo-grid__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
  }

  .photo-grid__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: opacity 0.2s var(--ease-out);
  }

  .photo-grid__btn:hover .photo-grid__img {
    opacity: 0.85;
  }

  .photo-grid__caption {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-secondary);
    text-align: left;
  }

  .lightbox__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 100%;
    max-height: 100%;
  }

  .lightbox__caption {
    color: var(--text-primary-dim);
    font-size: 0.9rem;
    text-align: center;
    max-width: 60ch;
  }

  .lightbox__caption[hidden] {
    display: none;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(5, 5, 5, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 5vw, 4rem);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100vh - 10rem);
    object-fit: contain;
    border: 1px solid var(--border);
  }

  .lightbox__close {
    position: absolute;
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-size: 1.1rem;
    line-height: 1;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    transition: color 0.2s var(--ease-out), border-color 0.2s var(--ease-out);
  }

  .lightbox__close:hover {
    color: var(--crimson-text);
    border-color: var(--crimson);
  }
</style>
